          <span>{hub.title}</span>
        </nav>

        <section class="mb-8 border-r-2 border-[#d4af37] pr-5 sm:mb-10 sm:pr-7" aria-labelledby="hub-heading">
          <p class="mb-2 text-xs font-bold tracking-wide text-[#d4af37]">{portal.title} <span class="px-1 text-white/35">•</span> {level}</p>
          <h1 id="hub-heading" class="font-amiri text-3xl font-bold leading-tight text-[#d4af37] sm:text-4xl">{hub.title}</h1>
          <p class="mt-3 max-w-3xl text-sm leading-7 text-white/75 sm:text-base">{hubSummary}</p>
