    <dialog
      id="quick-peek"
      class="m-auto w-[calc(100%-2rem)] max-w-xl rounded-3xl border border-[#d4af37]/35 bg-[#111]/95 p-0 text-white shadow-2xl backdrop:bg-black/75 backdrop:backdrop-blur-md"
      aria-labelledby="quick-peek-title"
    >
      <div class="p-6 sm:p-8">
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="mb-2 text-xs font-bold text-[#d4af37]">معاينة معرفية</p>
            <h2 id="quick-peek-title" class="font-amiri text-2xl font-bold text-white"></h2>
          </div>
          <button type="button" onclick="window.closeQuickPeek()" aria-label="إغلاق المعاينة" class="rounded-full border border-white/15 px-3 py-1 text-lg text-white/70 transition hover:border-[#d4af37] hover:text-[#d4af37]">×</button>
        </div>
        <p id="quick-peek-summary" class="mt-5 text-sm leading-7 text-white/75"></p>
        <div class="mt-6 rounded-2xl border border-[#d4af37]/25 bg-[#d4af37]/[0.06] p-5">
          <p class="mb-2 text-xs font-bold text-[#d4af37]">الخلاصة التنفيذية</p>
          <p id="quick-peek-executive" class="text-sm leading-7 text-white/80"></p>
        </div>
      </div>
    </dialog>

    <script>
      declare global {
        interface Window {
          openQuickPeek: (button: HTMLElement) => void;
          closeQuickPeek: () => void;
        }
      }

      window.openQuickPeek = (button) => {
        const dialog = document.querySelector<HTMLDialogElement>('#quick-peek');
        const title = document.querySelector<HTMLElement>('#quick-peek-title');
        const summary = document.querySelector<HTMLElement>('#quick-peek-summary');
        const executive = document.querySelector<HTMLElement>('#quick-peek-executive');
        if (!dialog || !title || !summary || !executive) {
          throw new Error('The knowledge preview dialog is missing required elements.');
        }
        title.textContent = button.dataset.previewTitle ?? '';
        summary.textContent = button.dataset.previewSummary ?? '';
        executive.textContent = button.dataset.previewExecutive ?? '';
        dialog.showModal();
      };

      window.closeQuickPeek = () => document.querySelector<HTMLDialogElement>('#quick-peek')?.close();
      document.addEventListener('click', (event) => {
        const dialog = document.querySelector<HTMLDialogElement>('#quick-peek');
        if (dialog && event.target === dialog) dialog.close();
      });

      const passportKey = 'memaar:route-passport';
      const previousPassportKey = 'memaar:previous-route-passport';

      function syncPassport() {
        const currentPassport = document.body.dataset.passport;
        const status = document.querySelector<HTMLElement>('#passport-status');
        const resumeLink = document.querySelector<HTMLAnchorElement>('#passport-resume');
        if (!currentPassport) {
          throw new Error('The current academy route passport is missing.');
        }

        try {
          const previous = localStorage.getItem(passportKey);
          if (previous) {
            const previousRoute = JSON.parse(previous) as { pathname?: unknown };
            if (typeof previousRoute.pathname === 'string' && previousRoute.pathname !== location.pathname) {
              localStorage.setItem(previousPassportKey, previous);
            }
          }

          localStorage.setItem(passportKey, JSON.stringify({
            ...JSON.parse(currentPassport),
            pathname: location.pathname,
            savedAt: new Date().toISOString(),
          }));

          const savedPrevious = localStorage.getItem(previousPassportKey);
          if (savedPrevious && resumeLink) {
            const previousRoute = JSON.parse(savedPrevious) as { pathname?: unknown };
            if (typeof previousRoute.pathname === 'string' && previousRoute.pathname.startsWith('/')) {
              resumeLink.href = previousRoute.pathname;
            }
          }
        } catch (error) {
