      "عمارة النية والرسالة (تصحيح النية، معنى التفوق، الأمانة العلمية، الدراسة رسالة)",
      "حصون الوعي واليقين (مواجهة الشبهات، بناء الثقة الفكرية، ترسيخ اليقين، حسن التوكل)",
      "آداب الطلب وشخصية المتعلم (هيبة العلم، احترام المعلم، مهارات السؤال، أخلاق البيئة الأكاديمية)",
      "بر الوالدين ومفاتيح التوفيق (رضا الوالدين، التوازن الأسري، إدارة الخلافات، بيئة داعمة)"
    ]
  },
  {
    id: 2,
    titleMain: "مِعْمَار الذَّات",
    titleSub: "(النفس والدافعية والصلابة)",
    short: "معمار الذات",
    axes: [
      "السيادة على الذات",
      "السكينة وإدارة الضغوط",
      "هندسة الدافعية والإنجاز",
      "الصلابة النفسية ومواجهة التحديات"
    ],
    axesDetailed: [
      "السيادة على الذات (التحرر من العادات المدمرة، إدارة الرغبات، الانضباط، إعادة بناء الإرادة)",
      "السكينة وإدارة الضغوط (قلق الامتحانات، التوتر الدراسي، الاتزان النفسي، طلب المساعدة)",
      "هندسة الدافعية والإنجاز (عقلية النمو، علاج التسويف، صناعة العادات، الاستمرارية)",
      "الصلابة النفسية ومواجهة التحديات (التعامل مع الفشل، مقاومة التنمر، الثقة بالنفس، البيئة المحفزة)"
    ]
  },
  {
    id: 3,
    titleMain: "مِعْمَار الإتْقَان",
    titleSub: "(المهارات والاستراتيجيات)",
    short: "معمار الإتقان",
    axes: [
      "التعلم الذكي والإتقان المعرفي",
      "السيادة الرقمية والتركيز",
      "التخطيط وصناعة المستقبل",
      "القراءة والتفكير الناقد"
    ],
    axesDetailed: [
      "التعلم الذكي والإتقان المعرفي (الاستدعاء النشط، التكرار المتباعد، تقنية فاينمان، الخرائط الذهنية)",
      "السيادة الرقمية والتركيز (استخدام الذكاء الاصطناعي، مقاومة التشتت، إدارة الوقت، الوعي الرقمي)",
      "التخطيط وصناعة المستقبل (تحديد الأهداف، إدارة الأولويات، التخطيط الأكاديمي، الرؤية المهنية)",
      "القراءة والتفكير الناقد (مهارات القراءة، تحليل المعلومات، التلخيص والمراجعة، الثقافة الشخصية)"
    ]
  },
  {
    id: 4,
    titleMain: "مِعْمَار القُوَّة",
    titleSub: "(الصحة والعلاقات والقدوات)",
    short: "معمار القوة",
    axes: [
      "طاقة الجسد وصحة الدماغ",
      "العلاقات والبيئة المحفزة",
      "القدوات والسير الملهمة",
      "خريطة المعارف والهوية"
    ],
    axesDetailed: [
      "طاقة الجسد وصحة الدماغ (النوم الصحي، التغذية الذكية، النشاط البدني، مقاومة الإرهاق)",
      "العلاقات والبيئة المحفزة (اختيار الأصدقاء، مقاومة الصحبة السلبية، الذكاء الاجتماعي، الشبكة الداعمة)",
      "القدوات والسير الملهمة (علماء الأمة، النماذج الناجحة، قصص التميز، دروس الإنجاز)",
      "خريطة المعارف والهوية (الهوية الإسلامية، الثقافة الأساسية، اختيار المراجع، القضايا المعاصرة)"
    ]
  },
  {
    id: 5,
    titleMain: "مِعْمَار المَنَارَة",
    titleSub: "(التميز الأكاديمي والتوجيه الوطني)",
    short: "معمار المنارة",
    axes: [
      "البوابة الأكاديمية الرسمية",
      "بنك التميز والامتحانات",
      "الأساتذة والمصادر الموثوقة",
      "الشراكة الأسرية للنجاح"
    ],
    axesDetailed: [
      "البوابة الأكاديمية الرسمية (منصات الوزارة، التوجيه الجامعي، المنح والخدمات، المستجدات التعليمية)",
      "بنك التميز والامتحانات (الحوليات الرسمية، نماذج التصحيح، استراتيجيات الامتحان، المراجعة المكثفة)",
      "الأساتذة والمصادر الموثوقة (أفضل القنوات التعليمية، الأساتذة المتميزون، الموارد الرقمية، المصادر المعتمدة)",
      "الشراكة الأسرية للنجاح (دور الأسرة، الدعم النفسي، التواصل الإيجابي، إدارة الأزمات الدراسية)"
    ]
  }
];
---
<!DOCTYPE html>
<html lang="ar" dir="rtl" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>أكاديمية مِعْمَار — للنجاح الدراسي</title>
  <link href="https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400&family=Aref+Ruqaa:wght@400;700&family=Cairo:wght@300;400;600;700;900&family=Reem+Kufi:wght@400;500;700&display=swap" rel="stylesheet">
  <style>
    @import "tailwindcss";
    :root {
      --mem-black: #121212;
      --mem-surface: #121212;
      --mem-gold: #D4AF37;
      --mem-ivory: #F5F5F3;
      --mem-sky: #0EA5E9; /* أزرق سماوي ناعم ومشرق */
    }
    body { background-color: var(--mem-black); color: var(--mem-ivory); font-family: 'Cairo', 'Tahoma', sans-serif; }
    .text-gold-grad { background: linear-gradient(135deg, #F4E5A1 0%, #D4AF37 50%, #A8842A 100%); -webkit-background-clip: text; background-clip: text; color: transparent; }
    .pillar-card { transition: transform 0.35s ease, box-shadow 0.35s ease, border-color 0.35s ease; background-color: var(--mem-surface); }
    .pillar-card:hover { transform: translateY(-4px) scale(1.01); border-color: var(--mem-gold); box-shadow: 0 20px 50px -20px rgba(212,175,55,0.25); }
    @keyframes shimmer {
      0% { opacity: 0.4; }
      50% { opacity: 1; }
      100% { opacity: 0.4; }
    }
    .shimmer-divider { background: linear-gradient(90deg, transparent, rgba(212,175,55,0.6), transparent); animation: shimmer 4s linear infinite; }
  </style>
</head>
<body class="min-h-screen antialiased">

  <!-- الترويسة العلويّة الملكية -->
  <header class="sticky top-0 z-50 w-full bg-[#121212]/95 backdrop-blur-xl border-b border-[#D4AF37]/30">
    <div class="max-w-7xl mx-auto flex items-center justify-between gap-4 h-20 px-4 lg:px-8">
      
      <a href="/" class="flex items-center gap-3 group shrink-0">
        <img src="/images/memaar-logo.png" alt="شعار" class="w-12 h-12 object-contain" />
        <span class="hidden sm:flex flex-col leading-tight">
          <span class="text-base lg:text-lg font-bold text-gold-grad" style="font-family: 'Aref Ruqaa', serif;">أكاديمية مِعْمَار</span>
          <span class="text-[10px] text-[#F5F5F3]/60">للنجاح الدراسي</span>
        </span>
      </a>

      <div class="relative flex-1 max-w-md mx-4">
        <span class="absolute inset-y-0 right-4 flex items-center text-[#D4AF37]">🔍</span>
        <input type="search" placeholder="ابحث في الأكاديمية..." class="w-full h-11 pr-11 pl-4 bg-[#1A1D24] border border-[#D4AF37]/40 rounded-full text-sm outline-none text-[#F5F5F3] focus:border-[#D4AF37]" />
      </div>

      <div class="hidden lg:flex items-center gap-3 border-r border-[#F5F5F3]/10 pr-5 shrink-0">
        <img 
          src="/images/supervisor.jpg" 
          alt="رماضنة عبد العزيز" 
          class="w-12 h-12 rounded-full border-2 border-[#D4AF37] object-cover shadow-[0_0_15px_rgba(212,175,55,0.3)] shrink-0" 
          onerror="this.src='https://via.placeholder.com/150'"
        />
        <div class="text-right leading-tight">
          <p class="text-[#F5F5F3] font-semibold text-[11px] opacity-95">إشراف الأستاذ الباحث رماضنة عبد العزيز</p>
          <p class="text-[#D4AF37] font-bold text-xs mt-0.5" style="font-family: 'Reem Kufi', sans-serif;">باحث دراسات اسلامية عليا</p>
        </div>
      </div>

    </div>
  </header>

  <!-- الخانات الأفقية الخمس الكبرى (Mega Menu) -->
  <nav class="w-full bg-[#121212] py-4 px-4 lg:px-8 border-b border-[#D4AF37]/20 relative z-40">
    <div class="max-w-7xl mx-auto grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3">
      {pillarsData.map((pillar) => (
        <div class="relative group">
          <a 
            href={`/pillar/${pillar.id}`}
            class="w-full h-full min-h-[75px] px-3 py-2.5 rounded-xl bg-[#1A1D24] border border-[#D4AF37]/40 hover:border-[#D4AF37] shadow-lg flex flex-col items-center justify-center text-center transition-all duration-300 group-hover:bg-[#222631] cursor-pointer block"
          >
            <div class="flex items-center justify-center gap-1.5 mb-1">
              <span class="text-base">🏛️</span>
              <span class="text-[#F5F5F3] text-sm font-bold tracking-wide" style="font-family: 'Aref Ruqaa', serif;">
                {pillar.titleMain}
              </span>
            </div>
            <span class="text-[#D4AF37] text-[10px] line-clamp-1 opacity-90 font-amiri">
              {pillar.titleSub}
            </span>
          </a>

          <!-- القائمة المنسدلة السحابية -->
          <div class="absolute right-0 lg:-right-12 top-full mt-2 w-[90vw] sm:w-[360px] bg-[#12141C] border-2 border-[#D4AF37]/50 rounded-2xl p-4 shadow-[0_15px_40px_rgba(0,0,0,0.9)] opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 transform translate-y-2 group-hover:translate-y-0 z-50">
            <div class="border-b border-[#D4AF37]/30 pb-2 mb-3 text-center">
              <h3 class="text-[#D4AF37] text-sm font-bold" style="font-family: 'Aref Ruqaa', serif;">
                {pillar.titleMain} {pillar.titleSub}
              </h3>
            </div>
            <ul class="space-y-2">
              {pillar.axesDetailed.map((axisDetail) => (
                <li>
                  <a 
                    href={`/pillar/${pillar.id}`} 
                    class="flex items-start gap-2 p-2 rounded-lg bg-white/[0.02] hover:bg-white/[0.06] border border-transparent hover:border-[#D4AF37]/40 transition-all text-xs text-[#F5F5F3] hover:text-[#D4AF37]"
                  >
                    <span class="text-[#D4AF37] text-xs mt-0.5">✦</span>
                    <span class="leading-relaxed font-amiri">{axisDetail}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </nav>

  <!-- البانر الرئيسي -->
  <section class="relative px-4 lg:px-8 pt-8 pb-4">
    <div class="relative mx-auto max-w-7xl rounded-3xl border-2 border-[#D4AF37]/40 bg-gradient-to-b from-[#1A1D24] to-[#121212] p-5 lg:p-9 overflow-hidden shadow-2xl">
      
      <div class="flex flex-col lg:flex-row items-center justify-between gap-6 mb-8 relative z-10">
        
        <!-- صور العلماء الإسلاميين -->
        <div class="flex items-center justify-center gap-6 order-2 lg:order-1 w-full lg:w-1/3">
          <figure class="text-center group">
            <div class="w-28 h-28 lg:w-32 lg:h-32 rounded-full border-4 border-[#D4AF37] overflow-hidden shadow-[0_0_20px_rgba(212,175,55,0.3)] mx-auto transition-transform duration-300 group-hover:scale-105">
              <img src="/images/qaradawi.jpg" onerror="this.src='https://via.placeholder.com/150'" class="w-full h-full object-cover" />
            </div>
            <figcaption class="text-sm lg:text-base text-[#F5F5F3] font-bold mt-3 tracking-wide drop-shadow-md" style="font-family: 'Aref Ruqaa', serif;">الشيخ الفقيه يوسف القرضاوي</figcaption>
          </figure>
          
          <figure class="text-center group">
            <div class="w-28 h-28 lg:w-32 lg:h-32 rounded-full border-4 border-[#D4AF37] overflow-hidden shadow-[0_0_20px_rgba(212,175,55,0.3)] mx-auto transition-transform duration-300 group-hover:scale-105">
              <img src="/images/albani.jpg" onerror="this.src='https://via.placeholder.com/150'" class="w-full h-full object-cover" />
            </div>
            <figcaption class="text-sm lg:text-base text-[#F5F5F3] font-bold mt-3 tracking-wide drop-shadow-md" style="font-family: 'Aref Ruqaa', serif;">الشيخ المحدث محمد ناصر الدين الألباني</figcaption>
          </figure>
        </div>

        <!-- الشعار الأوسط والتحفيز -->
        <div class="flex flex-col items-center order-1 lg:order-2 w-full lg:w-1/3 text-center">
          <img src="/images/memaar-logo.png" alt="شعار" onerror="this.style.display='none'" class="w-28 h-28 lg:w-36 lg:h-36 object-contain" />
          <h2 class="mt-3 text-3xl lg:text-5xl font-bold text-gold-grad leading-tight drop-shadow-md" style="font-family: 'Aref Ruqaa', serif;">ضع بصمتك..</h2>
          <p class="mt-2 text-lg lg:text-2xl text-[#F5F5F3]" style="font-family: 'Aref Ruqaa', serif;">قاتل من أجل أحلامك.</p>
          <a href="/pillar/1" class="mt-4 px-8 py-2.5 rounded-full border border-[#D4AF37] bg-[#121212] text-[#D4AF37] font-bold hover:bg-[#D4AF37] hover:text-[#121212] transition-all text-sm shadow-md inline-block">ابدأ رحلتك الآن</a>
        </div>

        <!-- صور الفيزيائيين -->
        <div class="flex items-center justify-center gap-6 order-3 lg:order-3 w-full lg:w-1/3">
          <figure class="text-center group">
            <div class="w-28 h-28 lg:w-32 lg:h-32 rounded-full border-4 border-[#D4AF37] overflow-hidden shadow-[0_0_20px_rgba(212,175,55,0.3)] mx-auto transition-transform duration-300 group-hover:scale-105">
              <img src="/images/tesla.jpg" onerror="this.src='https://via.placeholder.com/150'" class="w-full h-full object-cover" />
            </div>
            <figcaption class="text-sm lg:text-base text-[#F5F5F3] font-bold mt-3 tracking-wide drop-shadow-md" style="font-family: 'Aref Ruqaa', serif;">العالم الفيزيائي نيكولا تسلا</figcaption>
          </figure>

          <figure class="text-center group">
            <div class="w-28 h-28 lg:w-32 lg:h-32 rounded-full border-4 border-[#D4AF37] overflow-hidden shadow-[0_0_20px_rgba(212,175,55,0.3)] mx-auto transition-transform duration-300 group-hover:scale-105">
              <img src="/images/einstein.jpg" onerror="this.src='https://via.placeholder.com/150'" class="w-full h-full object-cover" />
            </div>
            <figcaption class="text-sm lg:text-base text-[#F5F5F3] font-bold mt-3 tracking-wide drop-shadow-md" style="font-family: 'Aref Ruqaa', serif;">العالم الفيزيائي ألبرت أينشتاين</figcaption>
          </figure>
        </div>

      </div>

      <!-- اقتباسات العلماء والبطاقة الوسطى -->
      <div class="w-full mx-auto mt-10 relative z-10 flex flex-col lg:flex-row items-stretch justify-center gap-4 lg:gap-6">
        
        <div class="w-full lg:w-1/3 bg-[#121212] border border-[#D4AF37]/30 rounded-2xl p-5 flex flex-col justify-center shadow-xl">
          <p class="text-[#F5F5F3] text-base lg:text-lg leading-relaxed text-justify mb-4 font-amiri">
            قال العلامة الإمام ابن القيم الجوزية: "فمن طلب العلم ليحيى به الإسلام فهو من الصديقين ودرجته بعد درجة النبوة". <br/><span class="text-xs text-[#D4AF37] block mt-1">— مفتاح دار السعادة (1/121)</span>
          </p>
          <div class="w-full h-px bg-[#D4AF37]/20 my-2"></div>
          <p class="text-[#F5F5F3] text-base lg:text-lg leading-relaxed text-justify font-amiri">
            وقال رحمه الله: «الهمة العالية تغلي في قلب صاحبها كغليان القدر، فلا تتركه يهدأ حتى توصله إلى قمة مَجْده.»
          </p>
        </div>

        <div class="w-full lg:w-1/3 relative rounded-2xl border-2 border-[#D4AF37] overflow-hidden shadow-[0_0_30px_rgba(212,175,55,0.2)]">
          <img src="/images/zewail-nobel.jpg" onerror="this.style.display='none'" class="w-full h-full object-cover" />
          <div class="absolute bottom-0 p-4 w-full text-center bg-gradient-to-t from-black via-black/80 to-transparent">
            <p class="text-base lg:text-lg font-bold text-white drop-shadow-md">تكريم العالم المصري أحمد زويل ..</p>
            <p class="text-sm text-[#D4AF37] font-bold mt-1">بصمات عربية في سجل الخلود</p>
          </div>
        </div>

        <div class="w-full lg:w-1/3 bg-[#121212] border border-[#D4AF37]/30 rounded-2xl p-5 flex flex-col justify-center shadow-xl gap-3">
          <p class="text-[#F5F5F3] text-sm lg:text-base leading-relaxed text-justify font-amiri">
            «الموهبة تجعلك متفوقاً، لكن العمل الشاق والمستمر هو ما يجعلك عبقرياً.»
            <span class="text-[11px] text-[#D4AF37] block mt-1">— ليوناردو دا فينشي</span>
          </p>
          <div class="w-full h-px bg-[#D4AF37]/20"></div>
          <p class="text-[#F5F5F3] text-sm lg:text-base leading-relaxed text-justify font-amiri">
            «النجاح ليس نتيجة اشتعال ذاتي تلقائي، بل يجب عليك أن تشعل عود الثقاب بنفسك.»
            <span class="text-[11px] text-[#D4AF37] block mt-1">— أرنولد غلاسكو</span>
          </p>
        </div>

      </div>
    </div>
  </section>

  <!-- بطاقات المعامير (خلفية سوداء فاحمة بالكامل، مع إطار الأيقونة بالأزرق السماوي المتناسق) -->
  <section class="relative px-4 lg:px-8 pt-10 pb-6">
    <div class="max-w-7xl mx-auto text-center mb-10">
      <h2 class="text-3xl lg:text-5xl font-bold text-gold-grad mt-3 leading-tight drop-shadow-lg" style="font-family: 'Aref Ruqaa', serif;">المعمار المعرفي للأكاديمية</h2>
      <div class="w-40 h-px shimmer-divider mx-auto mt-6"></div>
    </div>
    
    <div class="max-w-7xl mx-auto space-y-6">
      
      <!-- السطر الأول: المعامير الأربعة الأولى -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
        {pillarsData.slice(0, 4).map((pillar) => (
          <article class="pillar-card group relative rounded-3xl border-2 border-[#D4AF37]/30 p-5 flex flex-col justify-between shadow-xl bg-[#121212]">
            
            <div>
              <!-- رأس البطاقة: الإطار الصغير بالأزرق السماوي المتناسق مع الكتابة البيضاء/الذهبية -->
              <div class="flex items-center justify-between mb-4">
                <div class="px-3 py-1.5 rounded-xl bg-[#0F172A] text-[#38BDF8] border-2 border-[#38BDF8]/60 flex items-center justify-center gap-1.5 text-base shadow-md font-bold font-kufi">
                  <span>🏛️</span>
                  <span>{pillar.short}</span>
                </div>
                <span class="text-[10px] font-bold text-[#121212] bg-[#D4AF37] px-2.5 py-0.5 rounded-full shadow-md">4 بوابات</span>
              </div>
              
              <!-- العنوان الرئيسي بخط أكبر وتحته مباشرة التوضيح بين قوسين -->
              <div class="mb-4 text-center border-b border-white/10 pb-3">
                <h3 class="text-xl font-bold text-[#F5F5F3] tracking-wide" style="font-family: 'Aref Ruqaa', serif;">
                  <a href={`/pillar/${pillar.id}`} class="hover:text-[#D4AF37] transition-colors">{pillar.titleMain}</a>
                </h3>
                <p class="text-xs text-[#D4AF37] font-semibold mt-1 font-amiri">
                  {pillar.titleSub}
                </p>
              </div>

              <!-- إطار عرض المحاور الأربعة الأساسية -->
              <div class="mb-4 p-3 rounded-xl bg-[#121212] border border-white/10 space-y-2">
                <p class="text-[11px] font-bold text-[#D4AF37] border-b border-white/10 pb-1 font-kufi">✦ المحاور الأساسية:</p>
                <ul class="space-y-2">
                  {pillar.axes.map((axis, i) => (
                    <li class="text-xs text-[#F5F5F5] flex items-center gap-2 font-cairo font-semibold">
                      <span class="text-[#D4AF37] font-bold shrink-0">{i + 1}.</span>
