import { ViewTransitions } from 'astro:transitions';
import { memaarData } from '../../../../../../data/memaarData';
import '../../../../../../styles/global.css';

const portals = [
  { slug: 'resala', title: 'مِعْمَار الرِّسَالَة', subtitle: 'الهوية والإيمان والأخلاق', index: 0 },
  { slug: 'zaat', title: 'مِعْمَار الذَّات', subtitle: 'النفس والدافعية والصلابة', index: 1 },
  { slug: 'itqan', title: 'مِعْمَار الإتْقَان', subtitle: 'التعلم والتفوق الأكاديمي', index: 2 },
  { slug: 'quwa', title: 'مِعْمَار القُوَّة', subtitle: 'الثقافة والوقت والقدوات', index: 3 },
  { slug: 'manara', title: 'مِعْمَار المَنَارَة', subtitle: 'المسار الوطني ورعاية الأسرة', index: 4 },
] as const;

const levels = {
  level1: 'رَوَاسِخُ البِنَاءِ',
  level2: 'قِمَمُ المعالي',
} as const;

const contentTypes = ['article', 'book', 'video', 'tree'] as const;
const contentLabels = {
  article: { title: 'المقالات والأبحاث', icon: '▤', kind: 'مقال معرفي' },
  book: { title: 'الكتب والطروحات', icon: '▥', kind: 'كتاب ومرجع' },
  video: { title: 'المرئيات والدروس', icon: '▷', kind: 'درس مرئي' },
  tree: { title: 'الشجرة المعرفية', icon: '⌘', kind: 'خريطة معرفية' },
} as const;

export function getStaticPaths() {
  const routePortals = [
    { slug: 'resala', index: 0 },
    { slug: 'zaat', index: 1 },
    { slug: 'itqan', index: 2 },
    { slug: 'quwa', index: 3 },
    { slug: 'manara', index: 4 },
  ];
  const routeLevels = ['level1', 'level2'];
  const routeContentTypes = ['article', 'book', 'video', 'tree'];

  return routePortals.flatMap((portal) => {
    const hubs = memaarData[portal.index].gates;
    return routeLevels.flatMap((levelId) =>
      hubs.flatMap((hub) =>
        routeContentTypes.map((contentType) => ({
          params: {
            mimaarId: portal.slug,
            levelId,
            hubId: String(hub.id),
            contentType,
          },
        })),
      ),
    );
  });
}

const { mimaarId, levelId, hubId, contentType } = Astro.params;
const portal = portals.find((item) => item.slug === mimaarId);
const level = levelId === 'level1' ? levels.level1 : levelId === 'level2' ? levels.level2 : undefined;
const hub = portal && memaarData[portal.index].gates.find((item) => String(item.id) === hubId);
const selectedType = contentType && contentTypes.find((item) => item === contentType);

if (!portal || !level || !hub || !selectedType) {
  throw new Error('Invalid academy route: portal, level, hub, or content type was not found.');
}

const axes = hub.axes;
const hubSummary = axes.join('، ');
const cards = contentTypes.map((type) => ({
  type,
  ...contentLabels[type],
  title: `${hub.title} — ${contentLabels[type].kind}`,
  summary: type === 'tree'
    ? `تتفرع هذه الشجرة من محور البوابة: ${hubSummary}`
    : `استكشف ${hub.title} من خلال ${contentLabels[type].title}. ${axes[0] ?? ''}`,
  executiveSummary: `الخلاصة التنفيذية: ${hubSummary}`,
}));
