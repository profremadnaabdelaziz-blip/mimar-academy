---
import '../styles/global.css';
interface Props { title: string; }
const { title } = Astro.props;
---
<!DOCTYPE html>
<html lang="ar" dir="rtl" class="scroll-smooth">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <link href="https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400&family=Aref+Ruqaa:wght@400;700&family=Cairo:wght@300;400;600;700;900&family=Reem+Kufi:wght@400;500;700&display=swap" rel="stylesheet">
</head>
<body class="bg-mem-black text-mem-ivory font-traditional min-h-screen antialiased selection:bg-mem-burgundy selection:text-white">
  <slot />
</body>
</html>
3. ملف src/pages/index.astro (الملف الجامع لكل شيء)
astro
---
import Layout from '../layouts/Layout.astro';
import { memaarData } from '../data/memaarData';
---
<Layout title="أكاديمية مِعْمَار — للنجاح الدراسي">

  <!-- الترويسة -->
  <header class="sticky top-0 z-50 w-full bg-mem-black/95 backdrop-blur-xl border-b border-mem-gold/40">
    <div class="max-w-7xl mx-auto flex items-center justify-between gap-4 h-20 px-4 lg:px-8">
      <a href="/" class="flex items-center gap-3 group shrink-0">
        <img src="/images/memaar-logo.png" alt="شعار" class="w-12 h-12 object-contain" />
        <span class="hidden sm:flex flex-col leading-tight">
          <span class="text-base lg:text-lg font-bold text-gold-grad font-maryam">أكاديمية مِعْمَار</span>
          <span class="text-[10px] text-mem-ivory/50">للنجاح الدراسي</span>
        </span>
      </a>
      <div class="relative flex-1 max-w-md">
        <span class="absolute inset-y-0 right-4 flex items-center text-mem-gold">🔍</span>
        <input type="search" placeholder="ابحث..." class="w-full h-11 pr-11 pl-4 bg-mem-black border border-mem-gold/45 rounded-full text-sm outline-none text-mem-ivory" />
      </div>
      <div class="hidden lg:flex items-center gap-3 border-r border-mem-ivory/10 pr-5">
        <div class="text-left text-[11px] leading-tight">
          <p class="text-mem-gold font-bold">المشرف العام</p>
          <p class="text-mem-ivory font-semibold">أ. رماضنة عبد العزيز</p>
        </div>
        <span class="w-10 h-10 rounded-full border-2 border-mem-gold bg-[#12141a] flex items-center justify-center">🧔</span>
      </div>
    </div>
  </header>

  <!-- البانر الرئيسي -->
  <section class="relative px-4 lg:px-8 pt-8 pb-4">
    <div class="relative mx-auto max-w-7xl rounded-3xl border-2 border-mem-gold/55 bg-gradient-to-b from-[#12141a] to-mem-black p-5 lg:p-9 overflow-hidden gold-glow-soft">
      <div class="flex flex-col lg:flex-row items-center justify-between gap-6 mb-8 relative z-10">
        <!-- صورة الأستاذ (يسار) -->
        <div class="flex flex-col items-center order-3 lg:order-1 w-full lg:w-1/4">
          <img src="/images/supervisor.jpg" alt="الأستاذ" class="w-24 h-24 lg:w-32 lg:h-32 rounded-full border-4 border-mem-gold object-cover shadow-[0_0_20px_rgba(212,175,55,0.4)]" />
          <p class="mt-3 text-xs text-mem-ivory/70">تحت إشراف الأستاذ الباحث</p>
          <p class="text-base font-bold text-gold-grad font-maryam">رماضنة عبد العزيز</p>
        </div>
        <!-- الشعار (وسط) -->
        <div class="flex flex-col items-center order-1 lg:order-2 w-full lg:w-2/4">
          <img src="/images/memaar-logo.png" alt="شعار" class="w-28 h-28 lg:w-36 lg:h-36 object-contain drop-shadow-[0_0_20px_rgba(212,175,55,0.4)]" />
          <h2 class="mt-3 text-3xl lg:text-5xl font-bold text-gold-grad font-maryam leading-tight drop-shadow-md">ضع بصمتك..</h2>
          <p class="mt-2 text-lg lg:text-2xl text-mem-ivory font-thuluth">قاتل من أجل أحلامك.</p>
          <button class="mt-4 px-8 py-2 rounded-full border border-mem-gold bg-mem-black text-mem-gold font-bold hover:bg-mem-gold hover:text-mem-black transition-all text-sm">ابدأ رحلتك الآن</button>
        </div>
        <!-- العلماء (يمين) -->
        <div class="flex items-center justify-center gap-3 order-2 lg:order-3 w-full lg:w-1/4">
          <figure class="text-center"><img src="/images/albani.jpg" class="w-14 h-14 rounded-full border-2 border-mem-gold object-cover" /><figcaption class="text-[10px] text-mem-gold mt-1">الألباني</figcaption></figure>
          <figure class="text-center"><img src="/images/qaradawi.jpg" class="w-14 h-14 rounded-full border-2 border-mem-gold object-cover" /><figcaption class="text-[10px] text-mem-gold mt-1">القرضاوي</figcaption></figure>
          <figure class="text-center"><img src="/images/tesla.jpg" class="w-14 h-14 rounded-full border-2 border-mem-gold object-cover" /><figcaption class="text-[10px] text-mem-gold mt-1">تيسلا</figcaption></figure>
          <figure class="text-center"><img src="/images/einstein.jpg" class="w-14 h-14 rounded-full border-2 border-mem-gold object-cover" /><figcaption class="text-[10px] text-mem-gold mt-1">أينشتاين</figcaption></figure>
        </div>
      </div>
      <!-- إطار أحمد زويل (مستعد للأقوال) -->
      <div class="w-full max-w-3xl mx-auto mb-6 relative z-10">
        <div class="relative block aspect-video rounded-2xl border-2 border-mem-gold/60 overflow-hidden bg-[#0D0E12]">
          <img src="/images/zewail-nobel.jpg" class="absolute inset-0 w-full h-full object-cover opacity-60" />
          <div class="absolute bottom-0 p-4 w-full text-center bg-gradient-to-t from-mem-black to-transparent">
            <p class="text-xl font-bold text-mem-gold font-maryam">إطار مخصص لأقوال العلماء</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- بطاقات المعامير الخمسة -->
  <section class="relative px-4 lg:px-8 pt-10 pb-6">
    <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-5 gap-5 mt-10">
      {memaarData.map((pillar) => (
        <article class="pillar-card group relative rounded-3xl bg-[#12141a] border border-mem-gold/60 p-6 flex flex-col cursor-pointer">
          <h3 class="text-xl lg:text-2xl font-bold text-mem-ivory font-thuluth mb-3 group-hover:text-mem-gold">{pillar.title}</h3>
          <p class="text-[13px] text-mem-ivory/60 font-amiri flex-1 mb-4">{pillar.desc}</p>
          <a href={`/pillar/${pillar.id}`} class="block text-center w-full py-2 rounded-xl border border-mem-gold/40 text-xs font-bold text-mem-gold group-hover:bg-mem-gold group-hover:text-mem-black">استكشف المعمار ➔</a>
        </article>
      ))}
    </div>
  </section>

  <!-- قسم الختام (المسجد والتلاميذ) -->
  <section class="relative px-4 lg:px-8 py-16 bg-mem-black">
    <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-center justify-center gap-4 relative z-10">
      <div class="w-full md:w-1/4 h-64 md:h-80 rounded-2xl overflow-hidden border-2 border-mem-gold/50">
        <img src="/images/mosque.png" class="w-full h-full object-cover opacity-80" />
      </div>
      <div class="w-full md:w-2/4 h-80 md:h-[400px] rounded-3xl overflow-hidden border-4 border-mem-gold z-20">
        <img src="/images/students-group.jpg" class="w-full h-full object-cover opacity-90" />
        <div class="absolute bottom-6 inset-x-0 text-center">
          <p class="text-mem-gold font-bold font-kufi text-lg">أنت أيضاً يمكنك أن تكون قائداً</p>
        </div>
      </div>
      <div class="w-full md:w-1/4 h-64 md:h-80 rounded-2xl overflow-hidden border-2 border-mem-gold/50">
        <img src="/images/mosque.png" class="w-full h-full object-cover opacity-80 -scale-x-100" />
      </div>
    </div>
  </section>

  <!-- التذييل -->
  <footer class="border-t border-mem-gold/40 bg-[#0a0b0f] py-10 mt-8">
    <div class="max-w-7xl mx-auto px-4 text-center">
      <div class="flex justify-center gap-4 mb-6">
        <a href="#" class="bg-[#1877F2] text-white px-4 py-2 rounded-lg font-bold text-xs">فيسبوك</a>
        <a href="#" class="bg-[#FF0000] text-white px-4 py-2 rounded-lg font-bold text-xs">يوتيوب</a>
        <a href="#" class="bg-black text-white border border-white px-4 py-2 rounded-lg font-bold text-xs">X</a>
        <a href="#" class="bg-white text-black px-4 py-2 rounded-lg font-bold text-xs">تيك توك</a>
      </div>
      <p class="text-sm text-mem-ivory/65 font-amiri">جميع الحقوق محفوظة © 2026م — أكاديمية مِعْمَار</p>
    </div>
  </footer>

</Layout>