---
// src/pages/pillar/[id].astro
import AcademyLayout from '../../layouts/AcademyLayout.astro';
import Sidebar from '../../components/Sidebar.astro';
import PreviewModal from '../../components/PreviewModal.astro';
import { pillarsData } from '../../data/academyData'; // استدعاء البيانات

// هذه الدالة تخبر Astro بتوليد صفحات للمعامير من 1 إلى 5
export function getStaticPaths() {
  return pillarsData.map((pillar) => ({
    params: { id: String(pillar.id) }
  }));
}

const { id } = Astro.params;
---

<AcademyLayout title="تفاصيل المعمار — أكاديمية مِعْمَار">
  <div class="max-w-7xl mx-auto px-4 flex gap-6">
    
    <!-- الشريط الجانبي -->
    <Sidebar activePillarId={id} />

    <!-- محتوى الصفحة الداخلية (تجريبي) -->
    <main class="flex-1 py-10">
      <div class="bg-[#12141a] border border-[#d4af37]/30 rounded-3xl p-8 min-h-[60vh] flex flex-col items-center justify-center text-center">
        
        <h1 class="text-3xl font-amiri text-[#d4af37] mb-4">أنت الآن داخل المعمار رقم {id}</h1>
        <p class="text-white/60 mb-8">جرب النقر على الزر أدناه لفتح نافذة المعاينة السريعة (Quick Peek).</p>
        
        <!-- أزرار تجريبية لفتح النافذة -->
        <div class="flex flex-wrap gap-4 justify-center">
          <button 
            type="button"
            onclick="window.openQuickPeek({ type: 'مقال', title: 'هندسة الانضباط والسلامة النفسية', summary: 'دراسة منهجية تتحكم مسار الطالب نحو التحصيل العلمي الفائق وبناء مناعة عقلية ضد المشتتات والضغوط. تعلم كيف تحول الانضباط من عبء ثقيل إلى عادة يومية راسخة.', url: '#' })"
            class="px-6 py-3 rounded-xl bg-[#12141a] border border-[#d4af37]/40 text-[#d4af37] text-sm font-bold hover:bg-[#d4af37]/10 transition-colors"
          >
            📄 معاينة مقال
          </button>
          
          <button 
            type="button"
            onclick="window.openQuickPeek({ type: 'كتاب', title: 'عمارة النية ومفاتيح التوفيق الأكاديمي', summary: 'تأصيل شرعي وتربوي لمعنى طلب العلم وكيفية توجيه البوصلة القلبية لتحصيل البركة والتوفيق الإلهي.', url: '#', author: 'أ. رماضنة عبد العزيز', time: 'ساعة ونصف', pages: '140 صفحة', downloadUrl: '#' })"
            class="px-6 py-3 rounded-xl bg-[#d4af37] text-black text-sm font-bold hover:scale-105 transition-transform"
          >
            📚 معاينة كتاب
          </button>
        </div>

      </div>
    </main>

  </div>
</AcademyLayout>

<!-- استدعاء النافذة العائمة -->
<PreviewModal />
