    }
    body { background-color: var(--mem-black); color: var(--mem-ivory); font-family: 'Cairo', sans-serif; }
    .text-gold-grad { background: linear-gradient(135deg, #F4E5A1 0%, #D4AF37 50%, #A8842A 100%); -webkit-background-clip: text; background-clip: text; color: transparent; }
  </style>
</head>
<body class="min-h-screen antialiased bg-[#121212]">

  <!-- الترويسة -->
  <header class="sticky top-0 z-50 w-full bg-[#121212]/95 backdrop-blur-xl border-b border-[#D4AF37]/30">
    <div class="max-w-7xl mx-auto flex items-center justify-between gap-4 h-20 px-4 lg:px-8">
      <a href="/" class="flex items-center gap-3">
        <img src="/images/memaar-logo.png" alt="شعار" class="w-12 h-12 object-contain" />
        <span class="flex flex-col leading-tight">
          <span class="text-base lg:text-lg font-bold text-gold-grad" style="font-family: 'Aref Ruqaa', serif;">أكاديمية مِعْمَار</span>
          <span class="text-[10px] text-[#F5F5F3]/60">للنجاح الدراسي</span>
        </span>
      </a>

      <div class="flex items-center gap-3">
        <a href="/" class="px-5 py-2 rounded-full border border-[#D4AF37]/50 text-[#D4AF37] hover:bg-[#D4AF37] hover:text-[#121212] font-bold text-xs transition-all">الرئيسية ➔</a>
      </div>
    </div>
  </header>

  <!-- عنوان المعمار -->
  <section class="max-w-7xl mx-auto px-4 lg:px-8 pt-12 pb-6 text-center">
    <div class="inline-block px-4 py-1.5 rounded-xl bg-[#2C1810] text-[#D4AF37] border-2 border-[#D4AF37]/60 text-xs font-bold mb-3 shadow-md" style="font-family: 'Reem Kufi', sans-serif;">
      🏛️ المعمار {currentPillar.id} من المعامير الخمسة
    </div>
    <h1 class="text-3xl lg:text-5xl font-bold text-gold-grad leading-tight mb-2" style="font-family: 'Aref Ruqaa', serif;">
      {currentPillar.titleMain}
    </h1>
    <p class="text-base lg:text-lg text-[#D4AF37] font-semibold mb-4" style="font-family: 'Amiri', serif;">
      {currentPillar.titleSub}
    </p>
    <p class="max-w-4xl mx-auto text-base lg:text-xl text-[#F5F5F3]/90 leading-relaxed font-amiri">
      {currentPillar.subtitle}
    </p>

    {currentView !== 'all' && (
      <div class="mt-6 inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-[#2C1810] border border-[#D4AF37] text-xs font-bold text-[#D4AF37]">
        <span>🔍 العرض المفلتر حالياً:</span>
        <span class="text-white">
          {currentView === 'article' ? '📄 الأرشيف السحابي للمقالات والأبحاث' : ''}
          {currentView === 'book' ? '📚 المكتبة السحابية للكتب والأطروحات' : ''}
          {currentView === 'video' ? '🎥 الأرشيف السحابي للمرئيات والدروس' : ''}
        </span>
        <a href={`/pillar/${currentPillar.id}`} class="mr-2 text-white/60 hover:text-white underline">(عرض الكل)</a>
      </div>
    )}
  </section>

  <!-- بوابات ومحاور المعمار -->
  <section class="max-w-7xl mx-auto px-4 lg:px-8 py-8">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
      {currentPillar.gates.map((gate) => (
        <article class="p-6 rounded-3xl bg-[#121212] border-2 border-[#D4AF37]/30 hover:border-[#D4AF37] transition-all shadow-xl flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between mb-3 border-b border-[#D4AF37]/20 pb-3">
              <h3 class="text-xl font-bold text-[#D4AF37]" style="font-family: 'Aref Ruqaa', serif;">
                {gate.title}
              </h3>
              <span class="text-xs px-3 py-1 rounded-full bg-[#121212] text-[#D4AF37] border border-[#D4AF37]/50 font-bold">بوابة أصلية</span>
            </div>
            
            <p class="text-xs text-[#F5F5F3]/75 mb-4 leading-relaxed font-amiri">
              {gate.desc}
            </p>

            <div class="p-4 rounded-2xl bg-[#121212] border border-white/10 space-y-2">
              <p class="text-xs font-bold text-[#D4AF37] font-kufi border-b border-white/10 pb-1">✦ قضايا البوابة والمحاور التفصيلية:</p>
              <ul class="space-y-2 pt-1">
                {gate.axes.map((axis, i) => (
                  <li class="text-xs text-[#F5F5F3] flex items-start gap-2 font-cairo">
                    <span class="text-[#D4AF37] font-bold shrink-0">{i + 1}.</span>
                    <span class="leading-relaxed">{axis}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <div class="mt-6 pt-4 border-t border-white/10">
            <p class="text-[11px] font-bold text-[#E3B337] mb-2 font-kufi">الأرشيف والمحاريب المعرفية للبوابة:</p>
            <div class="grid grid-cols-3 gap-2">
              <a href={`/pillar/${currentPillar.id}?view=article`} class="p-2 rounded-lg bg-[#121212] border border-[#D4AF37]/40 hover:border-[#D4AF37] text-[10px] font-bold text-center text-[#F5F5F3] hover:text-[#D4AF37]">📄 مقالات</a>
              <a href={`/pillar/${currentPillar.id}?view=book`} class="p-2 rounded-lg bg-[#121212] border border-[#D4AF37]/40 hover:border-[#D4AF37] text-[10px] font-bold text-center text-[#F5F5F3] hover:text-[#D4AF37]">📚 كتب</a>
              <a href={`/pillar/${currentPillar.id}?view=video`} class="p-2 rounded-lg bg-[#121212] border border-[#D4AF37]/40 hover:border-[#D4AF37] text-[10px] font-bold text-center text-[#F5F5F3] hover:text-[#D4AF37]">🎥 مرئيات</a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- التنقل السريع -->
  <section class="max-w-7xl mx-auto px-4 lg:px-8 py-8">
    <div class="p-6 rounded-3xl bg-[#121212] border border-[#D4AF37]/30 text-center shadow-lg">
      <p class="text-sm font-bold text-[#D4AF37] mb-4 font-kufi">التنقل السريع بين المعامير الخمسة:</p>
      <div class="flex flex-wrap justify-center gap-3">
        {pillars.map((p) => (
          <a 
            href={`/pillar/${p.id}`} 
            class={`px-4 py-2 rounded-xl text-xs font-bold transition-all border ${p.id === pillarId ? 'bg-[#D4AF37] text-[#121212] border-[#D4AF37]' : 'bg-[#121212] text-[#F5F5F3] border-[#D4AF37]/40 hover:border-[#D4AF37]'}`}
          >
            {p.titleMain}
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- الفوتر -->
  <footer class="border-t border-[#D4AF37]/30 bg-[#0A0B0F] py-10 mt-12 text-center">
    <p class="text-lg text-gold-grad font-bold font-ruqaa mb-2">﴿يَرْفَعِ اللَّهُ الَّذِينَ آمَنُوا مِنْكُمْ وَالَّذِينَ أُوتُوا الْعِلْمَ دَرَجَاتٍ﴾ [المجادلة: 11]</p>[cite: 1]
    <p class="text-xs text-[#F5F5F3]/50">جميع الحقوق محفوظة © 2026م — أكاديمية مِعْمَار</p>
  </footer>

</body>
</html>