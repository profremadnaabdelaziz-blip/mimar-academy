---
// src/pages/index.astro
import AcademyLayout from '../layouts/AcademyLayout.astro';
import Banner from '../components/Banner.astro';
import { pillarsData } from '../data/academyData';

// توليد بيانات البحث ديناميكياً
const searchData = [
  ...pillarsData.map(p => ({ type: 'معمار', title: p.titleMain, desc: p.titleSub, href: `/pillar/${p.id}` })),
  ...pillarsData.flatMap(p => p.axes.map(a => ({ type: 'محور', title: a, desc: p.titleMain, href: `/pillar/${p.id}` }))),
  ...pillarsData.flatMap(p => [
    { type: 'مستوى', title: `المستوى الأول: ${p.titleMain}`, desc: 'رواسخ البناء (متوسط/ثانوي)', href: `/pillar/${p.id}/level1/articles` },
    { type: 'مستوى', title: `المستوى الثاني: ${p.titleMain}`, desc: 'قمم المعالي (جامعي)', href: `/pillar/${p.id}/level2/articles` }
  ])
];

// صور العلماء
const scholars = [
  { src: '/images/qaradawi.jpg', alt: 'الشيخ الفقيه يوسف القرضاوي', lines: ['الشيخ الفقيه', 'يوسف القرضاوي'] },
  { src: '/images/albani.jpg', alt: 'الشيخ المحدث محمد ناصر الدين الألباني', lines: ['الشيخ المحدث', 'محمد ناصر الدين الألباني'] },
  { src: '/images/tesla.jpg', alt: 'العالم نيكولا تسلا', lines: ['العالم الفيزيائي', 'نيكولا تسلا'], fallback: true },
  { src: '/images/einstein.jpg', alt: 'العالم ألبرت أينشتاين', lines: ['العالم الفيزيائي', 'ألبرت أينشتاين'] }
];

// صورة بديلة في حال عدم وجود أي صورة
const fallbackImg = 'data:image/svg+xml;utf8,' + encodeURIComponent('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 150 150"><rect width="150" height="150" fill="#1A1D24"/><circle cx="75" cy="58" r="26" fill="#D4AF37" opacity=".55"/><path d="M25 140c4-34 28-50 50-50s46 16 50 50z" fill="#D4AF37" opacity=".55"/></svg>');
const onErrFallback = `this.onerror=null;this.src='${fallbackImg}'`;
---

<AcademyLayout title="الرئيسية — أكاديمية مِعْمَار">

  <!-- 1. الترويسة العلويّة الملكية -->
  <header class="sticky top-0 z-50 w-full bg-[#121212]/95 backdrop-blur-xl border-b border-[#D4AF37]/30">
    <div class="max-w-7xl mx-auto flex items-center justify-between gap-4 h-20 px-4 lg:px-8">
      
      <a href="/" class="flex items-center gap-3 group shrink-0">
        <!-- اسم اللوغو الصحيح: memaar -->
        <img src="/images/memaar-logo-new.png" alt="شعار مِعْمَار" class="w-14 h-14 object-contain" onerror="this.src='/images/memaar-logo.png'" />
        <span class="hidden sm:flex flex-col leading-tight">
          <span class="text-base lg:text-lg font-bold text-gold-grad" style="font-family: 'Aref Ruqaa', serif;">أكاديمية مِعْمَار</span>
          <span class="text-[10px] text-[#F5F5F3]/60">للنجاح الدراسي</span>
        </span>
      </a>

      <div class="relative flex-1 max-w-md mx-4">
        <span class="absolute inset-y-0 right-4 flex items-center text-[#D4AF37]">🔍</span>
        <input type="search" data-open-cmdk placeholder="ابحث في الأكاديمية... (Ctrl+K)" class="w-full h-11 pr-11 pl-4 bg-[#1A1D24] border border-[#D4AF37]/40 rounded-full text-sm outline-none text-[#F5F5F3] focus:border-[#D4AF37] cursor-pointer" readonly />
      </div>

      <div class="hidden lg:flex items-center gap-3 border-r border-[#F5F5F3]/10 pr-5 shrink-0">
        <img src="/images/supervisor.jpg" alt="رماضنة عبد العزيز" class="w-12 h-12 rounded-full border-2 border-[#D4AF37] object-cover shadow-[0_0_15px_rgba(212,175,55,0.3)] shrink-0" onerror={onErrFallback} />
        <div class="text-right leading-tight">
          <p class="text-[#F5F5F3] font-semibold text-[11px] opacity-95">إشراف الأستاذ الباحث رماضنة عبد العزيز</p>
          <p class="text-[#D4AF37] font-bold text-xs mt-0.5" style="font-family: 'Reem Kufi', sans-serif;">باحث دراسات اسلامية عليا</p>
        </div>
      </div>

    </div>
  </header>

  <!-- 2. البانر الرسمي الفخم -->
  <Banner />

  <!-- 3. الخانات الأفقية الخمس الكبرى (Mega Menu) -->
  <nav class="w-full bg-[#121212] py-4 px-4 lg:px-8 border-b border-[#D4AF37]/20 relative z-40">
    <div class="max-w-7xl mx-auto grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-3">
      {pillarsData.map((pillar) => (
        <div class="relative group">
          <a href={`/pillar/${pillar.id}`} class="w-full h-full min-h-[75px] px-3 py-2.5 rounded-xl bg-[#1A1D24] border border-[#D4AF37]/40 hover:border-[#D4AF37] shadow-lg flex flex-col items-center justify-center text-center transition-all duration-300 group-hover:bg-[#222631] cursor-pointer block">
            <div class="flex items-center justify-center gap-1.5 mb-1">
              <span class="text-base">🏛️</span>
              <span class="text-[#F5F5F3] text-sm font-bold tracking-wide" style="font-family: 'Aref Ruqaa', serif;">{pillar.titleMain}</span>
            </div>
            <span class="text-[#D4AF37] text-[10px] line-clamp-1 opacity-90 font-amiri">{pillar.titleSub}</span>
          </a>

          <!-- القائمة المنسدلة السحابية -->
          <div class="absolute right-0 lg:-right-12 top-full mt-2 w-[90vw] sm:w-[360px] bg-[#12141C] border-2 border-[#D4AF37]/50 rounded-2xl p-4 shadow-[0_15px_40px_rgba(0,0,0,0.9)] opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-300 transform translate-y-2 group-hover:translate-y-0 z-50">
            <div class="border-b border-[#D4AF37]/30 pb-2 mb-3 text-center">
              <h3 class="text-[#D4AF37] text-sm font-bold" style="font-family: 'Aref Ruqaa', serif;">{pillar.titleMain} {pillar.titleSub}</h3>
            </div>
            <ul class="space-y-2">
              {pillar.axes.map((axis, index) => (
                <li>
                  <a href={`/pillar/${pillar.id}?axis=${index + 1}`} class="flex items-start gap-2 p-2 rounded-lg bg-white/[0.02] hover:bg-white/[0.06] border border-transparent hover:border-[#D4AF37]/40 transition-all text-xs text-[#F5F5F3] hover:text-[#D4AF37]">
                    <span class="text-[#D4AF37] text-xs mt-0.5">✦</span>
                    <span class="leading-relaxed font-amiri">{axis}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>
  </nav>

  <!-- 4. بطاقات المعامير -->
  <section id="pillars" class="relative px-4 lg:px-8 pt-10 pb-6">
    <div class="max-w-7xl mx-auto text-center mb-10">
      <h2 class="text-3xl lg:text-5xl font-bold text-gold-grad mt-3 leading-tight drop-shadow-lg" style="font-family: 'Aref Ruqaa', serif;">المعمار المعرفي للأكاديمية</h2>
      <div class="w-40 h-px shimmer-divider mx-auto mt-6"></div>
    </div>
    
    <div class="max-w-7xl mx-auto space-y-6">
      
      <!-- السطر الأول -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-5">
        {pillarsData.slice(0, 4).map((pillar) => (
          <article class="pillar-card group relative rounded-3xl border-2 border-[#D4AF37]/30 p-5 flex flex-col justify-between shadow-xl bg-[#121212]">
            <div>
              <div class="flex items-center justify-between mb-4">
                <div class="px-3 py-1.5 rounded-xl bg-[#0EA5E9]/10 text-[#0EA5E9] border-2 border-[#0EA5E9]/50 flex items-center justify-center gap-1.5 text-base shadow-md font-bold font-kufi">
                  <span>🏛️</span>
                  <span>{pillar.short}</span>
                </div>
                <span class="text-[10px] font-bold text-[#121212] bg-[#D4AF37] px-2.5 py-0.5 rounded-full shadow-md">4 بوابات</span>
              </div>
              
              <div class="mb-4 text-center border-b border-white/10 pb-3">
                <h3 class="text-xl font-bold text-[#F5F5F3] tracking-wide" style="font-family: 'Aref Ruqaa', serif;">
                  <a href={`/pillar/${pillar.id}`} class="hover:text-[#D4AF37] transition-colors">{pillar.titleMain}</a>
                </h3>
                <p class="text-xs text-[#D4AF37] font-semibold mt-1 font-amiri">{pillar.titleSub}</p>
              </div>

              <div class="w-full space-y-2.5 mb-3">
                <!-- المستوى الأول -->
                <div class="w-full bg-[#121212] border border-[#D4AF37]/40 rounded-xl shadow-md overflow-hidden">
                  <button type="button" class="toggle-level w-full py-2 px-2 flex items-center justify-between text-[10px] font-bold text-[#E3B337] font-kufi hover:bg-white/5 transition-colors">
                    <span>المستوى الأول: رَوَاسِخُ البِنَاءِ</span>
                    <span class="icon-arrow text-[10px] transition-transform duration-300">▼</span>
                  </button>
                  <div class="level-content hidden p-1.5 border-t border-[#D4AF37]/20 bg-[#121212]">
                    <div class="grid grid-cols-3 gap-1">
                      <a href={`/pillar/${pillar.id}/level1/articles`} class="p-1 rounded bg-[#121212] border border-[#D4AF37]/30 text-[9px] font-bold text-[#F5F5F3] hover:text-[#D4AF37] text-center block">📄 مقالات</a>
                      <a href={`/pillar/${pillar.id}/level1/books`} class="p-1 rounded bg-[#121212] border border-[#D4AF37]/30 text-[9px] font-bold text-[#F5F5F3] hover:text-[#D4AF37] text-center block">📚 كتب</a>
                      <a href={`/pillar/${pillar.id}/level1/videos`} class="p-1 rounded bg-[#121212] border border-[#D4AF37]/30 text-[9px] font-bold text-[#F5F5F3] hover:text-[#D4AF37] text-center block">🎥 مرئيات</a>
                    </div>
                  </div>
                </div>
                
                <!-- المستوى الثاني -->
                <div class="w-full bg-[#D4AF37] border border-[#121212] rounded-xl shadow-md overflow-hidden">
                  <button type="button" class="toggle-level w-full py-2 px-2 flex items-center justify-between text-[10px] font-bold text-[#121212] font-kufi hover:bg-black/10 transition-colors">
                    <span>المستوى الثاني: قِمَمُ المعالي</span>
                    <span class="icon-arrow text-[10px] transition-transform duration-300">▼</span>
                  </button>
                  <div class="level-content hidden p-1.5 border-t border-[#121212]/30 bg-[#121212]">
                    <div class="grid grid-cols-3 gap-1">
                      <a href={`/pillar/${pillar.id}/level2/articles`} class="p-1 rounded bg-[#121212] border border-[#12141A] text-[9px] font-bold text-[#F5F5F3] hover:text-[#D4AF37] text-center block">📄 مقالات</a>
                      <a href={`/pillar/${pillar.id}/level2/books`} class="p-1 rounded bg-[#121212] border border-[#12141A] text-[9px] font-bold text-[#F5F5F3] hover:text-[#D4AF37] text-center block">📚 كتب</a>
                      <a href={`/pillar/${pillar.id}/level2/videos`} class="p-1 rounded bg-[#121212] border border-[#12141A] text-[9px] font-bold text-[#F5F5F3] hover:text-[#D4AF37] text-center block">🎥 مرئيات</a>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <div class="pt-2 border-t border-white/10 text-center">
              <a href={`/pillar/${pillar.id}`} class="text-[11px] font-bold text-[#D4AF37] hover:underline">استعراض بوابات ومحاور المعمار الكاملة ➔</a>
            </div>
          </article>
        ))}
      </div>

      <!-- السطر الثاني: المعمار الخامس -->
      <div class="flex justify-center">
        {pillarsData.slice(4, 5).map((pillar) => (
          <article class="pillar-card group relative rounded-3xl border-2 border-[#D4AF37]/30 p-6 w-full lg:w-3/5 flex flex-col justify-between shadow-2xl bg-[#121212]">
            <div>
              <div class="flex items-center justify-between mb-4">
                <div class="px-4 py-2 rounded-xl bg-[#0EA5E9]/10 text-[#0EA5E9] border-2 border-[#0EA5E9]/50 flex items-center justify-center gap-2 text-lg shadow-md font-bold font-kufi">
                  <span>🏛️</span>
                  <span>{pillar.short}</span>
                </div>
                <span class="text-[11px] font-bold text-[#121212] bg-[#D4AF37] px-4 py-1 rounded-full shadow-md">4 بوابات أصلية</span>
              </div>
              
              <div class="mb-5 text-center border-b border-white/10 pb-4">
                <h3 class="text-2xl font-bold text-[#F5F5F5] tracking-wide" style="font-family: 'Aref Ruqaa', serif;">
                  <a href={`/pillar/${pillar.id}`} class="hover:text-[#D4AF37] transition-colors">{pillar.titleMain}</a>
                </h3>
                <p class="text-sm text-[#D4AF37] font-semibold mt-1 font-amiri">{pillar.titleSub}</p>
              </div>

              <div class="w-full space-y-3 mb-4">
                <div class="w-full bg-[#121212] border border-[#D4AF37]/40 rounded-xl shadow-md overflow-hidden">
                  <button type="button" class="toggle-level w-full py-2.5 px-3 flex items-center justify-between text-xs font-bold text-[#E3B337] font-kufi hover:bg-white/5 transition-colors">
                    <span>المستوى الأول: رَوَاسِخُ البِنَاءِ</span>
                    <span class="icon-arrow text-[10px] transition-transform duration-300">▼</span>
                  </button>
                  <div class="level-content hidden p-2 border-t border-[#D4AF37]/20 bg-[#121212]">
                    <div class="grid grid-cols-3 gap-2">
                      <a href={`/pillar/${pillar.id}/level1/articles`} class="p-1.5 rounded bg-[#121212] border border-[#D4AF37]/30 text-xs font-bold text-[#F5F5F3] hover:text-[#D4AF37] text-center block">📄 المقالات</a>
                      <a href={`/pillar/${pillar.id}/level1/books`} class="p-1.5 rounded bg-[#121212] border border-[#D4AF37]/30 text-xs font-bold text-[#F5F5F3] hover:text-[#D4AF37] text-center block">📚 الكتب</a>
                      <a href={`/pillar/${pillar.id}/level1/videos`} class="p-1.5 rounded bg-[#121212] border border-[#D4AF37]/30 text-xs font-bold text-[#F5F5F3] hover:text-[#D4AF37] text-center block">🎥 المرئيات</a>
                    </div>
                  </div>
                </div>
                
                <div class="w-full bg-[#D4AF37] border border-[#121212] rounded-xl shadow-md overflow-hidden">
                  <button type="button" class="toggle-level w-full py-2.5 px-3 flex items-center justify-between text-xs font-bold text-[#121212] font-kufi hover:bg-black/10 transition-colors">
                    <span>المستوى الثاني: قِمَمُ المعالي</span>
                    <span class="icon-arrow text-[10px] transition-transform duration-300">▼</span>
                  </button>
                  <div class="level-content hidden p-2 border-t border-[#121212]/30 bg-[#121212]">
                    <div class="grid grid-cols-3 gap-2">
                      <a href={`/pillar/${pillar.id}/level2/articles`} class="p-1.5 rounded bg-[#121212] border border-[#12141A] text-xs font-bold text-[#F5F5F3] hover:text-[#D4AF37] text-center block">📄 المقالات</a>
                      <a href={`/pillar/${pillar.id}/level2/books`} class="p-1.5 rounded bg-[#121212] border border-[#12141A] text-xs font-bold text-[#F5F5F3] hover:text-[#D4AF37] text-center block">📚 الكتب</a>
                      <a href={`/pillar/${pillar.id}/level2/videos`} class="p-1.5 rounded bg-[#121212] border border-[#12141A] text-xs font-bold text-[#F5F5F3] hover:text-[#D4AF37] text-center block">🎥 المرئيات</a>
                    </div>
                  </div>
                </div>
              </div>
            </div>
            <div class="pt-3 border-t border-white/10 text-center">
              <a href={`/pillar/${pillar.id}`} class="text-xs font-bold text-[#D4AF37] hover:underline">استعراض بوابات ومحاور المعمار الكاملة ➔</a>
            </div>
          </article>
        ))}
      </div>

    </div>
  </section>

  <!-- 5. قسم القدوات -->
  <section class="relative px-4 lg:px-8 py-16 bg-[#0D0E12] border-t border-[#D4AF37]/20">
    <div class="max-w-7xl mx-auto text-center mb-12">
      <h2 class="text-3xl lg:text-5xl font-bold text-gold-grad mt-3 leading-tight drop-shadow-lg" style="font-family: 'Aref Ruqaa', serif;">قدواتٌ تُنيرُ الدرب</h2>
      <p class="text-sm text-white/50 mt-4">علماء الأمة وقامات العلم الذين نستلهم منهم العزم والهمة</p>
      <div class="w-40 h-px shimmer-divider mx-auto mt-6"></div>
    </div>

    <div class="max-w-7xl mx-auto flex flex-wrap justify-center gap-8 lg:gap-12 mb-16">
      {scholars.map((s) => (
        <figure class="group flex flex-col items-center">
          <div class="w-40 h-56 lg:w-48 lg:h-72 rounded-full border-4 border-[#D4AF37] overflow-hidden shadow-[0_0_30px_rgba(212,175,55,0.2)] bg-[#1A1D24] transition-transform duration-500 group-hover:scale-105 group-hover:border-[#F4E5A1]">
            <img src={s.src} alt={s.alt} class="w-full h-full object-cover object-top transition-transform duration-500 group-hover:scale-110" onerror={s.fallback ? onErrFallback : undefined} />
          </div>
          <figcaption class="text-base lg:text-lg text-[#F5F5F3] font-bold mt-5 text-center tracking-wide" style="font-family: 'Aref Ruqaa', serif;">
            {s.lines[0]}<br />{s.lines[1]}
          </figcaption>
        </figure>
      ))}
    </div>

    <!-- قسم تكريم أحمد زويل -->
    <div class="max-w-4xl mx-auto px-4">
      <div class="relative rounded-3xl overflow-hidden border-4 border-[#D4AF37]/60 shadow-[0_0_50px_rgba(212,175,55,0.15)] group">
        <img 
          src="/images/zewail-nobel.jpg" 
          alt="تكريم العالم المصري أحمد زويل" 
          class="w-full h-64 md:h-96 object-cover object-center transition-transform duration-700 group-hover:scale-105"
          onerror={onErrFallback}
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[#0D0E12] via-[#0D0E12]/60 to-transparent flex flex-col justify-end p-6 md:p-10 text-center">
          <h3 class="text-2xl md:text-4xl font-bold text-white mb-2 drop-shadow-lg" style="font-family: 'Aref Ruqaa', serif;">
            تكريم العالم المصري أحمد زويل
          </h3>
          <p class="text-[#D4AF37] text-sm md:text-xl font-bold tracking-widest">
            بصمات عربية في سجل الخلود
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- 6. التذييل -->
  <footer class="border-t border-[#D4AF37]/30 bg-[#0A0B0F] py-14 mt-0">
    <div class="max-w-7xl mx-auto px-4 text-center">
      <div class="mb-10 px-4 flex flex-col items-center">
        <!-- اسم اللوغو الصحيح: memaar -->
        <img src="/images/memaar-logo-new.png" alt="شعار" class="w-24 h-24 object-contain mb-6 opacity-80" onerror="this.style.display='none'" />
        <p class="text-xl sm:text-2xl lg:text-3xl text-gold-grad leading-relaxed drop-shadow-xl" style="font-family: 'Aref Ruqaa', 'Amiri', serif; font-weight: 700;">
          ﴿يَرْفَعِ اللَّهُ الَّذِينَ آمَنُوا مِنْكُمْ وَالَّذِينَ أُوتُوا الْعِلْمَ دَرَجَاتٍ﴾ <span class="text-sm text-[#D4AF37]/70">[المجادلة: 11]</span>
        </p>
      </div>
      <div class="flex flex-wrap justify-center gap-3 mb-8">
        <a href="#" class="bg-[#1A1D24] text-[#D4AF37] border border-[#D4AF37]/60 px-6 py-1.5 rounded-sm font-bold text-xs hover:scale-105 transition-transform shadow-lg">فيسبوك</a>
        <a href="#" class="bg-[#D4AF37] text-[#121212] border border-[#121212] px-6 py-1.5 rounded-sm font-bold text-xs hover:scale-105 transition-transform shadow-lg">يوتيوب</a>
        <a href="#" class="bg-[#1A1D24] text-[#D4AF37] border border-[#D4AF37]/60 px-6 py-1.5 rounded-sm font-bold text-xs hover:scale-105 transition-transform shadow-lg">X</a>
        <a href="#" class="bg-[#D4AF37] text-[#121212] border border-[#121212] px-6 py-1.5 rounded-sm font-bold text-xs hover:scale-105 transition-transform shadow-lg">تيك توك</a>
      </div>
      <p class="text-sm text-[#F5F5F3]/60 mt-4" style="font-family: 'Amiri', serif;">جميع الحقوق محفوظة © 2026م — أكاديمية مِعْمَار</p>
    </div>
  </footer>

</AcademyLayout>

<!-- لوحة البحث السريع -->
<div id="cmdk-modal" class="hidden fixed inset-0 z-[100]" role="dialog" aria-modal="true" aria-label="بحث سريع">
  <div id="cmdk-backdrop" class="absolute inset-0 bg-black/80 backdrop-blur-sm transition-opacity"></div>
  <div class="relative mx-auto mt-[10vh] w-[min(650px,92vw)] rounded-2xl border-2 border-[#D4AF37]/60 bg-[#12141C] shadow-[0_20px_50px_rgba(0,0,0,0.9)] overflow-hidden transform scale-95 opacity-0 transition-all duration-300" id="cmdk-box">
    <div class="flex items-center gap-3 px-4 border-b border-[#D4AF37]/30 bg-[#1A1D24]">
      <span class="text-[#D4AF37] text-lg" aria-hidden="true">🔍</span>
      <input id="cmdk-input" type="text" autocomplete="off" placeholder="ابحث عن معمار، محور، أو مستوى..." class="flex-1 h-14 bg-transparent text-[#F5F5F3] placeholder-white/40 outline-none text-base font-cairo" />
      <kbd class="text-[10px] text-white/50 border border-white/20 rounded px-1.5 py-0.5 font-sans">ESC</kbd>
    </div>
    <ul id="cmdk-results" class="max-h-[55vh] overflow-y-auto p-2 space-y-1"></ul>
    <div id="cmdk-empty" class="hidden p-8 text-center text-sm text-white/50">لا توجد نتائج مطابقة لبحثك.</div>
    <div class="flex justify-between px-4 py-2 border-t border-[#D4AF37]/20 text-[11px] text-white/50 bg-[#121212]">
      <span>↑ ↓ للتنقل</span><span>Enter للفتح</span>
    </div>
  </div>
</div>

<!-- سكريبت تفعيل الأزرار المنسدلة ولوحة البحث -->
<script is:inline define:vars={{ searchData }}>
  document.addEventListener('DOMContentLoaded', () => {
    const toggleButtons = document.querySelectorAll('.toggle-level');
    toggleButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const content = btn.nextElementSibling;
        const arrow = btn.querySelector('.icon-arrow');
        if (content && arrow) {
          if (content.classList.contains('hidden')) {
            content.classList.remove('hidden');
            arrow.style.transform = 'rotate(180deg)';
          } else {
            content.classList.add('hidden');
            arrow.style.transform = 'rotate(0deg)';
          }
        }
      });
    });

    const modal = document.getElementById('cmdk-modal');
    const box = document.getElementById('cmdk-box');
    const input = document.getElementById('cmdk-input');
    const resultsList = document.getElementById('cmdk-results');
    const emptyState = document.getElementById('cmdk-empty');
    const backdrop = document.getElementById('cmdk-backdrop');
    const openBtns = document.querySelectorAll('[data-open-cmdk]');
    
    let currentIndex = 0;
    let filteredData = [];

    const normalize = (str) => {
      return (str || '').toLowerCase().replace(/[\u064B-\u0652]/g, '').replace(/[أإآ]/g, 'ا').replace(/ى/g, 'ي').replace(/ة/g, 'ه');
    };

    const openModal = () => {
      modal.classList.remove('hidden');
      setTimeout(() => { box.classList.remove('scale-95', 'opacity-0'); box.classList.add('scale-100', 'opacity-100'); }, 10);
      input.value = ''; renderResults(''); input.focus(); document.documentElement.style.overflow = 'hidden';
    };

    const closeModal = () => {
      box.classList.add('scale-95', 'opacity-0'); box.classList.remove('scale-100', 'opacity-100');
      setTimeout(() => { modal.classList.add('hidden'); document.documentElement.style.overflow = ''; }, 200);
    };

    const renderResults = (query) => {
      const q = normalize(query);
      filteredData = searchData.filter(item => normalize(item.title).includes(q) || normalize(item.desc).includes(q));
      resultsList.innerHTML = ''; currentIndex = 0;
      if (filteredData.length === 0) { emptyState.classList.remove('hidden'); return; }
      emptyState.classList.add('hidden');
      filteredData.forEach((item, index) => {
        const li = document.createElement('li');
        li.className = `flex items-center justify-between gap-3 px-4 py-3 rounded-xl cursor-pointer transition-colors ${index === 0 ? 'bg-[#D4AF37]/15 border border-[#D4AF37]/30' : 'hover:bg-white/5 border border-transparent'}`;
        li.dataset.index = index;
        li.innerHTML = `
          <div class="flex flex-col"><span class="text-sm text-white font-bold">${item.title}</span><span class="text-[11px] text-white/50">${item.desc}</span></div>
          <span class="text-[10px] font-bold text-[#D4AF37] bg-[#D4AF37]/10 px-2 py-1 rounded-md border border-[#D4AF37]/20">${item.type}</span>
        `;
        li.addEventListener('click', () => { window.location.href = item.href; });
        li.addEventListener('mouseenter', () => { updateSelection(index); });
        resultsList.appendChild(li);
      });
    };

    const updateSelection = (newIndex) => {
      const items = resultsList.querySelectorAll('li');
      items.forEach(li => { li.className = `flex items-center justify-between gap-3 px-4 py-3 rounded-xl cursor-pointer transition-colors hover:bg-white/5 border border-transparent`; });
      if (items[newIndex]) {
        items[newIndex].className = `flex items-center justify-between gap-3 px-4 py-3 rounded-xl cursor-pointer transition-colors bg-[#D4AF37]/15 border border-[#D4AF37]/30`;
        items[newIndex].scrollIntoView({ block: 'nearest' }); currentIndex = newIndex;
      }
    };

    openBtns.forEach(btn => btn.addEventListener('click', openModal));
    backdrop.addEventListener('click', closeModal);

    document.addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
        e.preventDefault(); if (modal.classList.contains('hidden')) openModal(); else closeModal(); return;
      }
      if (modal.classList.contains('hidden')) return;
      if (e.key === 'Escape') closeModal();
      else if (e.key === 'ArrowDown') { e.preventDefault(); if (currentIndex < filteredData.length - 1) updateSelection(currentIndex + 1); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); if (currentIndex > 0) updateSelection(currentIndex - 1); }
      else if (e.key === 'Enter') { e.preventDefault(); if (filteredData[currentIndex]) window.location.href = filteredData[currentIndex].href; }
    });

    input.addEventListener('input', (e) => renderResults(e.target.value));
  });
</script>