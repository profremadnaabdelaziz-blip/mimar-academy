---
// src/pages/academy/[portalSlug]/[...path].astro
import AcademyLayout from '../../../layouts/AcademyLayout.astro';
import { memaarData } from '../../../data/memaarData';
import { getPortal, getHub, hubUrl } from '../../../data/memaarConfig';
import { contentLabels, contentTypes, levelIds, levels } from '../../../data/memaarLabels';
import { getItemsByHubId, type ContentItem, type ContentType } from '../../../data/memaarContent';
import ContentCard from '../../../components/ContentCard.astro';

export function getStaticPaths() {
  return memaarData.flatMap((portal) =>
    portal.gates.flatMap((hub) =>
      levelIds.flatMap((levelId) =>
        contentTypes.map((type) => ({
          params: { portalSlug: portal.slug, path: `level-${levelId}/hub-${hub.id}/${type}` },
        })),
      ),
    ),
  );
}

const routeMatch = /^level-(\d+)\/hub-(\d+)\/(article|book|video)$/.exec(Astro.params.path ?? '');
const portal = getPortal(Astro.params.portalSlug);
const hub = getHub(portal, routeMatch?.[2]);
const levelKey = levelIds.find((id) => id === Number(routeMatch?.[1]));
const selectedType = contentTypes.find((t) => t === routeMatch?.[3]);

if (!portal || !hub || levelKey === undefined || !selectedType) {
  throw new Error(`Invalid academy route: ${Astro.url.pathname}`);
}

const gates = portal.gates;
const levelTitle = levels[levelKey];
const axes = hub.axes ?? [];
const hubSummary = axes.join('، ');
const hubItems = getItemsByHubId(hub.id);
const itemsOf = (type: ContentType) => hubItems.filter((item: ContentItem) => item.type === type);

const cards = contentTypes.map((type) => {
  const meta = contentLabels[type];
  return {
    type,
    ...meta,
    cardTitle: `${hub.title} — ${meta.kind}`,
    summary: `استكشف ${hub.title} من خلال ${meta.title}. ${axes[0] ?? ''}`,
    executive: `الخلاصة التنفيذية داخل المستوى: ${hubSummary}`,
    count: itemsOf(type).length,
    href: hubUrl(portal.slug, levelKey, hub.id, type),
    active: type === selectedType,
  };
});

const featured = cards.find((c) => c.active)!;
const others = cards.filter((c) => !c.active);

const articles = itemsOf('article');
const books = itemsOf('book');
const videos = itemsOf('video');

const hubIndex = gates.findIndex((g) => g === hub);
const prevHub = gates[hubIndex - 1];
const nextHub = gates[hubIndex + 1];
---

<AcademyLayout
  title={`${hub.title} | ${portal.title} — أكاديمية مِعْمَار`}
  description={hubSummary || `${hub.title} — ${levelTitle}`}
>
  <a slot="header-start" href="/" class="text-sm font-bold text-[#d4af37] transition-colors hover:text-white">← الرئيسية</a>
  <span slot="header-end" class="hidden text-xs text-white/60 sm:inline">{portal.title}</span>

  <main
    class="mx-auto w-full max-w-6xl px-4 py-8 sm:px-6 sm:py-12"
    id="hub-main"
    data-last-href={Astro.url.pathname}
    data-last-title={`${hub.title} — ${levelTitle}`}
  >
    <nav aria-label="مسار الطالب" class="mb-8">
      <ol class="flex flex-wrap items-center gap-2 text-xs text-white/55">
        <li><a href="/" class="transition hover:text-[#d4af37]">الرئيسية</a></li>
        <li aria-hidden="true">/</li>
        <li class="text-[#d4af37]">{portal.title}</li>
        <li aria-hidden="true">/</li>
        <li>{levelTitle}</li>
        <li aria-hidden="true">/</li>
        <li aria-current="page" class="text-white/85">{hub.title}</li>
      </ol>
    </nav>

    <section class="mb-8 border-r-2 border-[#d4af37] pr-5 sm:pr-7">
      <p class="mb-2 text-xs font-bold text-[#d4af37]">{portal.short}</p>
      <h1 class="font-amiri text-3xl font-bold leading-tight text-[#d4af37] sm:text-5xl">{hub.title}</h1>
      {hubSummary && <p class="mt-4 max-w-2xl text-sm leading-8 text-white/75">{hubSummary}</p>}
    </section>

    <div class="mb-10 flex flex-col gap-4 lg:flex-row lg:items-center lg:justify-between">
      <div class="inline-flex w-fit rounded-full border border-[#d4af37]/30 bg-black/40 p-1" role="group" aria-label="المستوى">
        {levelIds.map((id) => (
          <a
            href={hubUrl(portal.slug, id, hub.id, selectedType)}
            aria-current={id === levelKey ? 'page' : undefined}
            class={`rounded-full px-4 py-1.5 text-xs transition-all ${
              id === levelKey ? 'bg-[#d4af37] font-bold text-black shadow-md' : 'text-white/70 hover:text-[#d4af37]'
            }`}
          >
            {levels[id]}
          </a>
        ))}
      </div>

      <nav aria-label="نوع المحتوى" class="flex flex-wrap gap-2">
        {cards.map((c) => (
          <a
            href={c.href}
            aria-current={c.active ? 'page' : undefined}
            class={`rounded-full border px-4 py-2 text-xs transition-all ${
              c.active
                ? 'border-[#d4af37] bg-[#d4af37] font-bold text-black'
                : 'border-white/15 text-white/70 hover:border-[#d4af37]/60 hover:text-[#d4af37]'
            }`}
          >
            <span aria-hidden="true" class="ml-1.5">{c.icon}</span>{c.title}
            {c.count > 0 && <span class="mr-1.5 text-[10px] opacity-70">({c.count})</span>}
          </a>
        ))}
      </nav>
    </div>

    <article class="mb-6 rounded-3xl border border-[#d4af37]/40 bg-white/[0.04] p-6 sm:p-9" transition:name="featured-card">
      <div class="mb-5 flex items-center justify-between">
        <span class="flex h-12 w-12 items-center justify-center rounded-xl border border-[#d4af37]/40 bg-[#d4af37]/10 text-xl text-[#d4af37]" aria-hidden="true">{featured.icon}</span>
        <span class="rounded-full border border-[#d4af37]/30 bg-[#d4af37]/10 px-3 py-1 text-[11px] font-bold text-[#d4af37]">{featured.kind}</span>
      </div>
      <h2 class="mb-3 font-amiri text-2xl font-bold sm:text-3xl text-white">{featured.cardTitle}</h2>
      <p class="mb-7 max-w-2xl text-sm leading-8 text-white/75">{featured.summary}</p>

      <div class="rounded-2xl border border-[#d4af37]/30 bg-[#d4af37]/10 p-4">
        <p class="mb-1 text-xs font-bold text-[#d4af37]">الخلاصة التنفيذية</p>
        <p class="text-sm leading-7 text-white/90">{featured.executive}</p>
      </div>

      <div class="mt-8 border-t border-white/10 pt-6">
        {hubItems.length === 0 && (
          <p class="text-sm leading-7 text-white/55">لم يُضف محتوى لهذه الخانة بعد. سيظهر هنا فور إضافته.</p>
        )}

      </div>
    </article>

    <div class="mb-8 flex flex-wrap gap-2" role="group" aria-label="تصفية المحتوى">
      {[
        { value: 'all', label: 'الكل' },
        { value: 'article', label: 'مقالات' },
        { value: 'book', label: 'كتب' },
        { value: 'video', label: 'مرئيات' },
      ].map((f) => (
        <button
          type="button"
          data-filter={f.value}
          aria-pressed={f.value === 'all' ? 'true' : 'false'}
          class="rounded-full border border-white/15 px-4 py-2 text-xs text-white/70 transition-all hover:border-[#d4af37]/60 hover:text-[#d4af37] aria-pressed:border-[#d4af37] aria-pressed:bg-[#d4af37] aria-pressed:font-bold aria-pressed:text-black"
        >
          {f.label}
        </button>
      ))}
    </div>

    {articles.length > 0 && (
      <section data-type-section="article" class="mb-10">
        <h2 class="mb-4 flex items-center gap-2 text-xl font-bold text-amber-400">
          <span class="h-2 w-2 rounded-full bg-emerald-400"></span> المقالات التحليلية
        </h2>
        <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
          {articles.map((item) => <ContentCard {...item} />)}
        </div>
      </section>
    )}

    {books.length > 0 && (
      <section data-type-section="book" class="mb-10">
        <h2 class="mb-4 flex items-center gap-2 text-xl font-bold text-amber-400">
          <span class="h-2 w-2 rounded-full bg-amber-400"></span> المراجع والكتب
        </h2>
        <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
          {books.map((item) => <ContentCard {...item} />)}
        </div>
      </section>
    )}

    {videos.length > 0 && (
      <section data-type-section="video" class="mb-10">
        <h2 class="mb-4 flex items-center gap-2 text-xl font-bold text-amber-400">
          <span class="h-2 w-2 rounded-full bg-sky-400"></span> الشروحات المرئية
        </h2>
        <div class="grid grid-cols-1 gap-5 md:grid-cols-2 lg:grid-cols-3">
          {videos.map((item) => <ContentCard {...item} />)}
        </div>
      </section>
    )}

    <section aria-label="خانات أخرى في هذا المحور" class="grid grid-cols-1 gap-4 sm:grid-cols-3">
      {others.map((c) => (
        <article class="flex flex-col justify-between rounded-2xl border border-white/10 bg-white/[0.03] p-5 transition-colors hover:border-[#d4af37]/40">
          <div>
            <div class="mb-3 flex items-center justify-between">
              <span class="text-lg text-[#d4af37]" aria-hidden="true">{c.icon}</span>
              <span class="text-[10px] text-white/55">{c.count > 0 ? `${c.count} عناصر` : c.kind}</span>
            </div>
            <h3 class="mb-2 font-amiri text-lg font-bold text-white">{c.title}</h3>
            <p class="mb-5 line-clamp-3 text-xs leading-7 text-white/60">{c.summary}</p>
          </div>
          <div class="flex gap-2">
            <a href={c.href} class="flex-1 rounded-xl bg-[#d4af37] px-3 py-2 text-center text-xs font-bold text-black transition hover:bg-white">فتح الخانة</a>
            <button
              type="button"
              data-peek
              data-title={c.cardTitle}
              data-summary={c.summary}
              data-executive={c.executive}
              class="rounded-xl border border-[#d4af37]/40 px-3 py-2 text-xs font-bold text-[#d4af37] transition hover:bg-[#d4af37]/10"
            >
              معاينة
            </button>
          </div>
        </article>
      ))}
    </section>

    {(prevHub || nextHub) && (
      <nav aria-label="المحاور المجاورة" class="mt-12 flex items-center justify-between gap-4 border-t border-white/10 pt-6 text-sm">
        {nextHub ? (
          <a href={hubUrl(portal.slug, levelKey, nextHub.id, selectedType)} class="text-white/70 transition hover:text-[#d4af37]">→ {nextHub.title}</a>
        ) : <span />}
        {prevHub ? (
          <a href={hubUrl(portal.slug, levelKey, prevHub.id, selectedType)} class="text-white/70 transition hover:text-[#d4af37]">{prevHub.title} ←</a>
        ) : <span />}
      </nav>
    )}
  </main>

  <dialog
    id="quick-peek"
    aria-labelledby="quick-peek-title"
    class="m-auto w-[calc(100%-2rem)] max-w-xl rounded-3xl border border-[#d4af37]/40 bg-[#0d0d0d] p-6 text-white shadow-2xl backdrop:bg-black/75"
  >
    <div class="mb-4 flex items-start justify-between gap-4">
      <div>
        <p class="mb-1 text-xs font-bold text-[#d4af37]">معاينة سريعة</p>
        <h2 id="quick-peek-title" class="font-amiri text-2xl font-bold"></h2>
      </div>
      <button type="button" data-peek-close aria-label="إغلاق" class="rounded-full border border-white/15 px-3 py-1 text-lg text-white/70 transition hover:text-[#d4af37]">×</button>
    </div>
    <p id="quick-peek-summary" class="mb-4 text-sm leading-7 text-white/75"></p>
    <div class="rounded-2xl border border-[#d4af37]/30 bg-[#d4af37]/10 p-4">
      <p class="mb-1 text-xs font-bold text-[#d4af37]">الخلاصة التنفيذية</p>
      <p id="quick-peek-executive" class="text-sm leading-7 text-white/90"></p>
    </div>
  </dialog>

  <style>
    dialog[open] { animation: peek-in 0.22s ease-out; }
    @keyframes peek-in {
      from { opacity: 0; transform: translateY(10px) scale(0.98); }
      to { opacity: 1; transform: none; }
    }
  </style>

  <script>
    function initHubPage() {
      const main = document.querySelector<HTMLElement>('#hub-main');
      if (main?.dataset.lastHref) {
        try {
          localStorage.setItem(
            'memaar:last',
            JSON.stringify({ href: main.dataset.lastHref, title: main.dataset.lastTitle ?? '' }),
          );
        } catch {}
      }

      const filterButtons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
      const typeSections = document.querySelectorAll<HTMLElement>('[data-type-section]');
      filterButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          const value = btn.dataset.filter;
          filterButtons.forEach((b) => b.setAttribute('aria-pressed', String(b === btn)));
          typeSections.forEach((section) => {
            section.hidden = value !== 'all' && section.dataset.typeSection !== value;
          });
        });
      });

      const dialog = document.querySelector<HTMLDialogElement>('#quick-peek');
      if (!dialog) return;
      const el = (id: string) => dialog.querySelector<HTMLElement>(id)!;

      document.querySelectorAll<HTMLElement>('[data-peek]').forEach((btn) => {
        btn.addEventListener('click', () => {
          el('#quick-peek-title').textContent = btn.dataset.title ?? '';
          el('#quick-peek-summary').textContent = btn.dataset.summary ?? '';
          el('#quick-peek-executive').textContent = btn.dataset.executive ?? '';
          dialog.showModal();
        });
      });
      dialog.querySelector('[data-peek-close]')?.addEventListener('click', () => dialog.close());
      dialog.addEventListener('click', (e) => {
        if (e.target === dialog) dialog.close();
      });
    }
    document.addEventListener('astro:page-load', initHubPage);
  </script>
</AcademyLayout>
