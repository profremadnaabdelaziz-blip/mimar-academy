---
import { ViewTransitions } from 'astro:transitions';
import { memaarData } from '../../../../../../data/memaarData';
import '../../../../../../styles/global.css';

const portals = [
  { slug: 'resala', title: 'مِعْمَار الرِّسَالَة', subtitle: 'الهوية والإيمان والأخلاق', index: 0 },
  { slug: 'zaat', title: 'مِعْمَار الذَّات', subtitle: 'النفس والدافعية والصلابة', index: 1 },
  { slug: 'itqan', title: 'مِعْمَار الإتْقَان', subtitle: 'التعلم والتفوق الأكاديمي', index: 2 },
  { slug: 'quwa', title: 'مِعْمَار القُوَّة', subtitle: 'الثقافة والوقت والقدوات', index: 3 },
  { slug: 'manara', title: 'مِعْمَار المَنَارَة', subtitle: 'المسار الوطني ورعاية الأسرة', index: 4 },
] as const;

const levels = {
  level1: 'رَوَاسِخُ البِنَاءِ',
  level2: 'قِمَمُ المعالي',
} as const;

const contentTypes = ['article', 'book', 'video', 'tree'] as const;
const contentLabels = {
  article: { title: 'المقالات والأبحاث', icon: '▤', kind: 'مقال معرفي' },
  book: { title: 'الكتب والطروحات', icon: '▥', kind: 'كتاب ومرجع' },
  video: { title: 'المرئيات والدروس', icon: '▷', kind: 'درس مرئي' },
  tree: { title: 'الشجرة المعرفية', icon: '⌘', kind: 'خريطة معرفية' },
} as const;

export function getStaticPaths() {
  const routePortals = [
    { slug: 'resala', index: 0 },
    { slug: 'zaat', index: 1 },
    { slug: 'itqan', index: 2 },
    { slug: 'quwa', index: 3 },
    { slug: 'manara', index: 4 },
  ];
  const routeLevels = ['level1', 'level2'];
  const routeContentTypes = ['article', 'book', 'video', 'tree'];

  return routePortals.flatMap((portal) => {
    const hubs = memaarData[portal.index].gates;
    return routeLevels.flatMap((levelId) =>
      hubs.flatMap((hub) =>
        routeContentTypes.map((contentType) => ({
          params: {
            mimaarId: portal.slug,
            levelId,
            hubId: String(hub.id),
            contentType,
          },
        })),
      ),
    );
  });
}

const { mimaarId, levelId, hubId, contentType } = Astro.params;
const portal = portals.find((item) => item.slug === mimaarId);
const level = levelId === 'level1' ? levels.level1 : levelId === 'level2' ? levels.level2 : undefined;
const hub = portal && memaarData[portal.index].gates.find((item) => String(item.id) === hubId);
const selectedType = contentType && contentTypes.find((item) => item === contentType);

if (!portal || !level || !hub || !selectedType) {
  throw new Error('Invalid academy route: portal, level, hub, or content type was not found.');
}

const axes = hub.axes;
const hubSummary = axes.join('، ');
const cards = contentTypes.map((type) => ({
  type,
  ...contentLabels[type],
  title: `${hub.title} — ${contentLabels[type].kind}`,
  summary: type === 'tree'
    ? `تتفرع هذه الشجرة من محور البوابة: ${hubSummary}`
    : `استكشف ${hub.title} من خلال ${contentLabels[type].title}. ${axes[0] ?? ''}`,
  executiveSummary: `الخلاصة التنفيذية: ${hubSummary}`,
}));
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0d0d0d" />
    <title>{hub.title} | {portal.title} — أكاديمية مِعْمَار</title>
    <ViewTransitions />
  </head>
  <body
    class="min-h-screen bg-[#0d0d0d] font-traditional text-white antialiased selection:bg-[#58111a] selection:text-white"
    data-passport={JSON.stringify({ mimaarId, levelId, hubId, contentType })}
  >
    <div class="min-h-screen">
      <header class="border-b border-[#d4af37]/25 bg-[#0d0d0d]/90 backdrop-blur-xl">
        <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-4 sm:px-6 lg:px-8">
          <a href="/" class="text-sm font-bold text-[#d4af37] transition-colors hover:text-white" transition:name="academy-brand">
            أكاديمية مِعْمَار
          </a>
          <a
            id="passport-resume"
            href="/"
            class="rounded-full border border-[#d4af37]/40 px-4 py-2 text-xs text-white/75 transition hover:border-[#d4af37] hover:text-[#d4af37]"
          >
            استئناف المسار
          </a>
        </div>
      </header>

      <main class="mx-auto max-w-7xl px-4 py-8 sm:px-6 sm:py-12 lg:px-8">
        <nav aria-label="مسار الطالب" class="mb-8 flex flex-wrap items-center gap-2 text-xs text-white/55">
          <a href="/" class="transition hover:text-[#d4af37]">الرئيسية</a>
          <span aria-hidden="true">/</span>
          <span class="text-[#d4af37]">{portal.title}</span>
          <span aria-hidden="true">/</span>
          <span>{level}</span>
          <span aria-hidden="true">/</span>
          <span>{hub.title}</span>
        </nav>

        <section class="mb-8 border-r-2 border-[#d4af37] pr-5 sm:mb-10 sm:pr-7" aria-labelledby="hub-heading">
          <p class="mb-2 text-xs font-bold tracking-wide text-[#d4af37]">{portal.title} <span class="px-1 text-white/35">•</span> {level}</p>
          <h1 id="hub-heading" class="font-amiri text-3xl font-bold leading-tight text-[#d4af37] sm:text-4xl">{hub.title}</h1>
          <p class="mt-3 max-w-3xl text-sm leading-7 text-white/75 sm:text-base">{hubSummary}</p>
          <div class="mt-5 flex flex-wrap gap-2" aria-label="أنواع المحتوى">
            {contentTypes.map((type) => (
              <a
                href={`/${portal.slug}/level/${levelId}/hub/${hub.id}/${type}`}
                aria-current={type === selectedType ? 'page' : undefined}
                class:list={[
                  'rounded-full border px-3 py-2 text-xs transition-colors',
                  type === selectedType
                    ? 'border-[#d4af37] bg-[#d4af37] font-bold text-[#0d0d0d]'
                    : 'border-white/15 text-white/70 hover:border-[#d4af37]/60 hover:text-[#d4af37]',
                ]}
                transition:animate="fade"
              >
                {contentLabels[type].title}
              </a>
            ))}
          </div>
        </section>

        <section aria-label="المحتوى المعرفي" class="grid auto-rows-[minmax(13rem,auto)] grid-cols-1 gap-4 sm:grid-cols-2 xl:grid-cols-4">
          {cards.map((card, index) => (
            <article
              class:list={[
                'group relative flex flex-col overflow-hidden rounded-2xl border bg-white/[0.035] p-5 backdrop-blur-sm transition duration-300 hover:-translate-y-1 hover:bg-white/[0.06] sm:p-6',
                card.type === selectedType ? 'border-[#d4af37]/65 shadow-[0_12px_42px_rgba(212,175,55,0.08)]' : 'border-white/10 hover:border-[#d4af37]/40',
                index === 0 ? 'sm:col-span-2 sm:row-span-2' : '',
              ]}
              transition:name={`knowledge-card-${card.type}`}
            >
              <div class="flex items-start justify-between gap-3">
                <span class="flex h-11 w-11 items-center justify-center rounded-xl border border-[#d4af37]/25 bg-[#d4af37]/[0.07] text-xl text-[#d4af37]" aria-hidden="true">{card.icon}</span>
                <span class="rounded-full bg-[#58111a]/60 px-3 py-1 text-[10px] font-bold text-white/85">{card.kind}</span>
              </div>
              <h2 class="mt-5 font-amiri text-xl font-bold leading-relaxed text-white sm:text-2xl">{card.title}</h2>
              <p class="mt-3 text-sm leading-7 text-white/65">{card.summary}</p>
              <div class="mt-auto pt-5">
                <button
                  type="button"
                  class="w-full rounded-xl border border-[#d4af37]/35 px-4 py-3 text-xs font-bold text-[#d4af37] transition hover:bg-[#d4af37] hover:text-[#0d0d0d] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#d4af37]"
                  onclick="window.openQuickPeek(this)"
                  data-preview-title={card.title}
                  data-preview-summary={card.summary}
                  data-preview-executive={card.executiveSummary}
                >
                  معاينة سريعة
                </button>
              </div>
            </article>
          ))}
        </section>

        <p id="passport-status" class="sr-only" aria-live="polite"></p>
      </main>
    </div>

    <dialog
      id="quick-peek"
      class="m-auto w-[calc(100%-2rem)] max-w-xl rounded-3xl border border-[#d4af37]/35 bg-[#111]/95 p-0 text-white shadow-2xl backdrop:bg-black/75 backdrop:backdrop-blur-md"
      aria-labelledby="quick-peek-title"
    >
      <div class="p-6 sm:p-8">
        <div class="flex items-start justify-between gap-4">
          <div>
            <p class="mb-2 text-xs font-bold text-[#d4af37]">معاينة معرفية</p>
            <h2 id="quick-peek-title" class="font-amiri text-2xl font-bold text-white"></h2>
          </div>
          <button type="button" onclick="window.closeQuickPeek()" aria-label="إغلاق المعاينة" class="rounded-full border border-white/15 px-3 py-1 text-lg text-white/70 transition hover:border-[#d4af37] hover:text-[#d4af37]">×</button>
        </div>
        <p id="quick-peek-summary" class="mt-5 text-sm leading-7 text-white/75"></p>
        <div class="mt-6 rounded-2xl border border-[#d4af37]/25 bg-[#d4af37]/[0.06] p-5">
          <p class="mb-2 text-xs font-bold text-[#d4af37]">الخلاصة التنفيذية</p>
          <p id="quick-peek-executive" class="text-sm leading-7 text-white/80"></p>
        </div>
      </div>
    </dialog>

    <script>
      declare global {
        interface Window {
          openQuickPeek: (button: HTMLElement) => void;
          closeQuickPeek: () => void;
        }
      }

      window.openQuickPeek = (button) => {
        const dialog = document.querySelector<HTMLDialogElement>('#quick-peek');
        const title = document.querySelector<HTMLElement>('#quick-peek-title');
        const summary = document.querySelector<HTMLElement>('#quick-peek-summary');
        const executive = document.querySelector<HTMLElement>('#quick-peek-executive');
        if (!dialog || !title || !summary || !executive) {
          throw new Error('The knowledge preview dialog is missing required elements.');
        }
        title.textContent = button.dataset.previewTitle ?? '';
        summary.textContent = button.dataset.previewSummary ?? '';
        executive.textContent = button.dataset.previewExecutive ?? '';
        dialog.showModal();
      };

      window.closeQuickPeek = () => document.querySelector<HTMLDialogElement>('#quick-peek')?.close();
      document.addEventListener('click', (event) => {
        const dialog = document.querySelector<HTMLDialogElement>('#quick-peek');
        if (dialog && event.target === dialog) dialog.close();
      });

      const passportKey = 'memaar:route-passport';
      const previousPassportKey = 'memaar:previous-route-passport';

      function syncPassport() {
        const currentPassport = document.body.dataset.passport;
        const status = document.querySelector<HTMLElement>('#passport-status');
        const resumeLink = document.querySelector<HTMLAnchorElement>('#passport-resume');
        if (!currentPassport) {
          throw new Error('The current academy route passport is missing.');
        }

        try {
          const previous = localStorage.getItem(passportKey);
          if (previous) {
            const previousRoute = JSON.parse(previous) as { pathname?: unknown };
            if (typeof previousRoute.pathname === 'string' && previousRoute.pathname !== location.pathname) {
              localStorage.setItem(previousPassportKey, previous);
            }
          }

          localStorage.setItem(passportKey, JSON.stringify({
            ...JSON.parse(currentPassport),
            pathname: location.pathname,
            savedAt: new Date().toISOString(),
          }));

          const savedPrevious = localStorage.getItem(previousPassportKey);
          if (savedPrevious && resumeLink) {
            const previousRoute = JSON.parse(savedPrevious) as { pathname?: unknown };
            if (typeof previousRoute.pathname === 'string' && previousRoute.pathname.startsWith('/')) {
              resumeLink.href = previousRoute.pathname;
            }
          }
        } catch (error) {
          console.error('Unable to synchronize the academy route passport.', error);
          if (status) status.textContent = 'تعذر حفظ موضع المسار على هذا الجهاز.';
        }
      }

      document.addEventListener('astro:page-load', syncPassport);
      syncPassport();
    </script>
  </body>
</html>
