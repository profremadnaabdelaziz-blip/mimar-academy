---
// src/components/BottomBar.astro — شريط التنقل السفلي الذكي والموسوعي للهواتف والتابلت
import { memaarData } from '../data/memaarData';
import { hubUrl, portalIcons } from '../data/memaarConfig';

interface Props {
  active?: string;
}
const { active } = Astro.props;

const items = memaarData.map((p) => ({
  slug: p.slug,
  label: p.short,
  icon: portalIcons[p.slug],
  total: p.gates.length,
  href: p.gates[0] ? hubUrl(p.slug, 'level1', p.gates[0].id, 'article') : '/',
  isActive: p.slug === active,
}));
---

<nav
  aria-label="البوابات الذكية"
  class="fixed inset-x-0 bottom-0 z-40 border-t border-[#d4af37]/30 bg-[#0d0d0d]/95 pb-[env(safe-area-inset-bottom)] backdrop-blur-xl lg:hidden transition-all duration-300"
  id="mobile-bottom-nav"
>
  <div class="mx-auto flex max-w-lg items-center justify-around px-2 py-1.5">
    {items.map((it) => (
      <a
        href={it.href}
        data-portal-link={it.slug}
        data-total={it.total}
        aria-current={it.isActive ? 'page' : undefined}
        class={`relative flex flex-col items-center gap-0.5 px-2 py-1 text-[11px] transition-colors ${
          it.isActive ? 'font-bold text-[#d4af37]' : 'text-white/60 hover:text-[#d4af37]'
        }`}
      >
        <span aria-hidden="true" class="text-lg leading-none">{it.icon}</span>
        <span class="max-w-full truncate font-['Cairo']">{it.label}</span>
        <span
          data-badge
          hidden
          class="absolute left-1/2 top-0 ml-3 flex h-4 min-w-4 items-center justify-center rounded-full bg-[#d4af37] px-1 text-[9px] font-bold text-black shadow-md"
        ></span>
      </a>
    ))}

    <!-- زر لوحة الأوامر السريعة (قَفْز / بحث) المدمج من الحزمة الجديدة -->
    <button
      type="button"
      data-open-palette
      class="flex flex-col items-center justify-center gap-0.5 px-2 py-1 text-[11px] text-white/60 hover:text-[#d4af37] transition-colors group"
      aria-label="بحث سريع"
    >
      <span class="text-lg leading-none" aria-hidden="true">🔍</span>
      <span class="font-['Cairo']">قَفْز</span>
    </button>
  </div>
</nav>

<script>
  import { getPassport, visitedCount } from '../lib/passport';

  function initBottomBar() {
    const passport = getPassport();
    
    // 1) تحديث الروابط والشارات بناءً على جواز السفر
    document.querySelectorAll<HTMLAnchorElement>('[data-portal-link]').forEach((a) => {
      const slug = a.dataset.portalLink!;
      const last = passport.byPortal[slug];
      if (last?.href) a.href = last.href;
      
      const left = Number(a.dataset.total) - visitedCount(passport, slug);
      const badge = a.querySelector<HTMLElement>('[data-badge]');
      if (badge && left > 0) {
        badge.textContent = String(left);
        badge.hidden = false;
        badge.setAttribute('aria-label', `${left} محاور لم تُزر`);
      }
    });

    // 2) تفعيل خاصية الاختفاء الذكي أثناء وضع القراءة المركزة (Zenith Mode)
    const bottomNav = document.getElementById('mobile-bottom-nav');
    if (bottomNav) {
      const observer = new MutationObserver(() => {
        if (document.body.classList.contains('focus-activated')) {
          bottomNav.style.transform = 'translateY(100%)';
        } else {
          bottomNav.style.transform = 'translateY(0)';
        }
      });
      observer.observe(document.body, { attributes: true, attributeFilter: ['class'] });
    }
  }

  document.addEventListener('astro:page-load', initBottomBar);
</script>