---
// src/components/BottomNav.astro
// إضافة وتحديث شريط التصفح السفلي الذكي للهواتف والتابلت لعام 2026
---

<div class="fixed bottom-0 inset-x-0 bg-[#0d0d0d]/95 backdrop-blur-md border-t border-[#58111a]/40 md:hidden z-40 transition-all duration-300" id="mobile-bottom-nav">
  <div class="flex justify-around items-center h-16 max-w-md mx-auto px-2">
    
    <!-- زر معمار الرسالة -->
    <a href="#pillar-1" class="flex flex-col items-center justify-center text-gray-400 hover:text-[#d4af37] active-state transition-colors gap-1 group">
      <span class="text-lg">✨</span>
      <span class="text-[10px] font-['Cairo'] font-medium">الرسالة</span>
    </a>

    <!-- زر معمار الذات -->
    <a href="#pillar-2" class="flex flex-col items-center justify-center text-gray-400 hover:text-[#d4af37] transition-colors gap-1 group">
      <span class="text-lg">🧠</span>
      <span class="text-[10px] font-['Cairo'] font-medium">الذات</span>
    </a>

    <!-- زر معمار الإتقان -->
    <a href="#pillar-3" class="flex flex-col items-center justify-center text-gray-400 hover:text-[#d4af37] transition-colors gap-1 group">
      <span class="text-lg">📚</span>
      <span class="text-[10px] font-['Cairo'] font-medium">الإتقان</span>
    </a>

    <!-- زر معمار القوة -->
    <a href="#pillar-4" class="flex flex-col items-center justify-center text-gray-400 hover:text-[#d4af37] transition-colors gap-1 group">
      <span class="text-lg">💪</span>
      <span class="text-[10px] font-['Cairo'] font-medium">القوة</span>
    </a>

    <!-- زر المنارة الجزائرية المعمار الخامس المعتمد -->
    <a href="#pillar-5" class="flex flex-col items-center justify-center text-[#d4af37] font-bold border-t-2 border-[#d4af37] pt-1 transition-colors gap-1 group" id="nav-manara-btn">
      <span class="text-lg">🇩🇿</span>
      <span class="text-[10px] font-['Cairo']">المنارة</span>
    </a>

    <!-- زر القفز السريع بالبحث المدمج لوحة الأوامر -->
    <button data-open-palette class="flex flex-col items-center justify-center text-gray-400 hover:text-[#d4af37] transition-colors gap-1 group">
      <span class="text-lg">🔍</span>
      <span class="text-[10px] font-['Cairo'] font-medium">قَفْز</span>
    </button>

  </div>
</div>

<script>
  // تفعيل خاصية "الاختفاء الذكي" للشريط السفلي أثناء تفعيل وضع القراءة المركزة (Zenith Mode)
  document.addEventListener('DOMContentLoaded', () => {
    const bottomNav = document.getElementById('mobile-bottom-nav');
    
    // مراقبة تفعيل وضع القراءة والتركيز من المكونات الأخرى
    const observer = new MutationObserver(() => {
      if (document.body.classList.contains('focus-activated')) {
        if (bottomNav) bottomNav.style.transform = 'translateY(100%)';
      } else {
        if (bottomNav) bottomNav.style.transform = 'translateY(0)';
      }
    });

    observer.observe(document.body, { attributes: true, attributeFilter: ['class'] });
  });
</script>