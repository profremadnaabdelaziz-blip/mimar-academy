---
// src/components/CommandPalette.astro — لوحة الأوامر السريعة (Ctrl/⌘ + K)
// تصل لأي بوابة أو محور أو عنصر محتوى فوراً. الفهرس يُبنى وقت البناء ويُدمج في الصفحة.
import { buildNavIndex } from '../lib/navIndex';

const index = buildNavIndex();
---

<script type="application/json" id="nav-index" set:html={JSON.stringify(index)} />

<dialog
  id="palette"
  aria-label="البحث السريع"
  class="mx-auto mb-auto mt-[12vh] w-[calc(100%-2rem)] max-w-xl overflow-hidden rounded-2xl border border-[#d4af37]/35 bg-[#111] p-0 text-white shadow-2xl backdrop:bg-black/75"
>
  <div class="border-b border-white/10 p-3">
    <input
      id="palette-input"
      type="text"
      role="combobox"
      aria-expanded="true"
      aria-controls="palette-list"
      aria-autocomplete="list"
      autocomplete="off"
      spellcheck="false"
      placeholder="اذهب إلى بوابة أو محور أو درس…"
      class="w-full bg-transparent px-2 py-2 text-sm text-white placeholder-white/40 focus:outline-none"
    />
  </div>
  <ul id="palette-list" role="listbox" aria-label="النتائج" class="max-h-[50vh] overflow-y-auto p-2"></ul>
  <p class="border-t border-white/10 px-4 py-2 text-[11px] text-white/45">
    ↑ ↓ للتنقل • Enter للفتح • Esc للإغلاق
  </p>
</dialog>

<script>
  import { navigate } from 'astro:transitions/client';
  import { normalizeArabic } from '../lib/arabic';
  import { getPassport } from '../lib/passport';

  interface NavEntry {
    kind: 'portal' | 'hub' | 'content';
    title: string;
    context: string;
    href: string;
    keywords: string;
  }

  const KIND_LABEL = { portal: 'بوابة', hub: 'محور', content: 'محتوى' } as const;
  const KIND_ORDER = { portal: 0, hub: 1, content: 2 } as const;

  // ---- مستمعات عامة تُسجَّل مرة واحدة فقط ----
  function openPalette() {
    const d = document.querySelector<HTMLDialogElement>('#palette');
    if (!d || d.open) return;
    d.showModal();
    d.dispatchEvent(new Event('palette:open'));
  }
  document.addEventListener('keydown', (e) => {
    if ((e.ctrlKey || e.metaKey) && e.code === 'KeyK') {
      e.preventDefault();
      openPalette();
    }
  });
  document.addEventListener('click', (e) => {
    if ((e.target as HTMLElement).closest('[data-palette-open]')) openPalette();
  });

  // ---- تهيئة كل صفحة ----
  function initPalette() {
    const dialog = document.querySelector<HTMLDialogElement>('#palette');
    const input = document.querySelector<HTMLInputElement>('#palette-input');
    const list = document.querySelector<HTMLUListElement>('#palette-list');
    if (!dialog || !input || !list || dialog.dataset.ready) return;
    dialog.dataset.ready = '1';

    const entries: NavEntry[] = JSON.parse(document.querySelector('#nav-index')?.textContent ?? '[]');
    const norm = entries.map((e) => ({
      title: normalizeArabic(e.title),
      all: normalizeArabic(`${e.title} ${e.context} ${e.keywords}`),
    }));

    let results: NavEntry[] = [];
    let active = 0;

    function defaults(): NavEntry[] {
      const last = getPassport().last;
      const portals = entries.filter((e) => e.kind === 'portal');
      if (!last) return portals;
      const resume: NavEntry = { kind: 'hub', title: last.title, context: 'آخر موضع زرته', href: last.href, keywords: '' };
      return [resume, ...portals];
    }

    function search(q: string): NavEntry[] {
      const terms = normalizeArabic(q).split(/\s+/).filter(Boolean);
      if (!terms.length) return defaults();
      return entries
        .map((entry, i) => {
          if (!terms.every((t) => norm[i].all.includes(t))) return null;
          const score = terms.reduce(
            (sum, t) => sum + (norm[i].title.startsWith(t) ? 3 : norm[i].title.includes(t) ? 2 : 1),
            0,
          );
          return { entry, score };
        })
        .filter((x): x is { entry: NavEntry; score: number } => x !== null)
        .sort((a, b) => b.score - a.score || KIND_ORDER[a.entry.kind] - KIND_ORDER[b.entry.kind])
        .slice(0, 8)
        .map((x) => x.entry);
    }

    function render() {
      list!.replaceChildren();
      if (!results.length) {
        const li = document.createElement('li');
        li.className = 'px-3 py-6 text-center text-sm text-white/50';
        li.textContent = 'لا توجد نتائج مطابقة';
        list!.append(li);
        input!.removeAttribute('aria-activedescendant');
        return;
      }
      results.forEach((r, i) => {
        const li = document.createElement('li');
        li.id = `palette-opt-${i}`;
        li.setAttribute('role', 'option');
        li.setAttribute('aria-selected', String(i === active));
        li.className =
          'flex cursor-pointer items-center justify-between gap-3 rounded-xl px-3 py-2.5 text-sm aria-selected:bg-[#d4af37]/15 aria-selected:text-[#d4af37]';

        const text = document.createElement('div');
        text.className = 'min-w-0';
        const title = document.createElement('p');
        title.className = 'truncate font-bold';
        title.textContent = r.title;
        const ctx = document.createElement('p');
        ctx.className = 'truncate text-xs text-white/50';
        ctx.textContent = r.context;
        text.append(title, ctx);

        const badge = document.createElement('span');
        badge.className = 'shrink-0 rounded-full bg-[#d4af37]/20 px-2 py-0.5 text-[10px] font-bold text-[#d4af37]';
        badge.textContent = KIND_LABEL[r.kind];

        li.append(text, badge);
        li.addEventListener('mousemove', () => setActive(i));
        li.addEventListener('click', () => go(r));
        list!.append(li);
      });
      input!.setAttribute('aria-activedescendant', `palette-opt-${active}`);
    }

    function setActive(i: number) {
      if (i === active || !results.length) return;
      active = (i + results.length) % results.length;
      list!.querySelectorAll('[role=option]').forEach((el, idx) => el.setAttribute('aria-selected', String(idx === active)));
      input!.setAttribute('aria-activedescendant', `palette-opt-${active}`);
      list!.querySelector(`#palette-opt-${active}`)?.scrollIntoView({ block: 'nearest' });
    }

    function go(r: NavEntry) {
      dialog!.close();
      navigate(r.href);
    }

    function refresh() {
      results = search(input!.value);
      active = 0;
      render();
    }

    input.addEventListener('input', refresh);
    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') { e.preventDefault(); setActive(active + 1); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(active - 1); }
      else if (e.key === 'Enter' && results[active]) { e.preventDefault(); go(results[active]); }
    });
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
    dialog.addEventListener('palette:open', () => { input.value = ''; refresh(); input.focus(); });
  }

  document.addEventListener('astro:page-load', initPalette);
</script>