---
---
<section class="relative px-4 lg:px-8 pt-8 pb-4">
  <div class="relative mx-auto max-w-7xl rounded-3xl border-2 border-mem-gold/55 bg-gradient-to-b from-[#12141a] to-mem-black p-5 lg:p-9 overflow-hidden gold-glow-soft">
    <canvas id="particles" class="absolute inset-0 w-full h-full pointer-events-none" aria-hidden="true"></canvas>
    <div class="flex flex-col items-center justify-center text-center mb-8 relative z-10">
      <img src="/images/memaar-logo.png" alt="شعار" class="w-32 h-32 lg:w-40 lg:h-40 object-contain drop-shadow-[0_0_20px_rgba(212,175,55,0.4)]" />
      <h2 class="mt-4 text-3xl lg:text-4xl font-bold text-gold-grad font-maryam leading-tight drop-shadow-md">ضع بصمتك..</h2>
      <p class="mt-2 text-lg lg:text-xl text-mem-ivory font-thuluth">قاتل من جل حلامك.</p>
      <button class="mt-4 px-8 py-2 rounded-full border border-mem-gold bg-mem-black text-mem-gold font-bold hover:bg-mem-gold hover:text-mem-black transition-all text-sm">ابد رحلتك الآن</button>
    </div>
    <div class="w-full max-w-3xl mx-auto mb-8 relative z-10">
      <a href="#" class="group relative block aspect-video rounded-2xl border-2 border-mem-gold/60 overflow-hidden bg-mem-panel shadow-[0_0_30px_rgba(212,175,55,0.15)]">
        <img src="/images/zewail-nobel.jpg" alt="حمد زويل" class="absolute inset-0 w-full h-full object-cover opacity-80 group-hover:scale-105 transition-transform duration-700" />
        <div class="absolute inset-0 flex items-center justify-center"><span class="w-16 h-16 lg:w-20 lg:h-20 bg-mem-gold rounded-full text-mem-black text-3xl flex items-center justify-center group-hover:scale-110 transition-transform shadow-[0_0_20px_rgba(212,175,55,0.6)]">▶</span></div>
        <div class="absolute bottom-0 p-4 w-full text-center bg-gradient-to-t from-mem-black via-mem-black/80 to-transparent">
          <p class="text-xl lg:text-2xl font-bold text-mem-gold font-maryam">العالم حمد زويل..</p>
          <p class="text-sm text-mem-ivory">نوبل الكيمياء وعنوان التفوق المصري</p>
        </div>
      </a>
    </div>
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-3xl mx-auto mb-8 relative z-10">
      <figure class="text-center"><img src="/images/albani.jpg" alt="اللباني" onerror="this.style.visibility='hidden'" class="w-20 h-20 lg:w-24 lg:h-24 rounded-full border-2 border-mem-gold object-cover mx-auto shadow-[0_0_15px_rgba(212,175,55,0.3)]" /><figcaption class="mt-2 text-sm text-mem-gold font-bold">الشيخ اللباني</figcaption></figure>
      <figure class="text-center"><img src="/images/qaradawi.jpg" alt="القرضاوي" onerror="this.style.visibility='hidden'" class="w-20 h-20 lg:w-24 lg:h-24 rounded-full border-2 border-mem-gold object-cover mx-auto shadow-[0_0_15px_rgba(212,175,55,0.3)]" /><figcaption class="mt-2 text-sm text-mem-gold font-bold">الشيخ القرضاوي</figcaption></figure>
      <figure class="text-center"><img src="/images/tesla.jpg" alt="تيسلا" onerror="this.style.visibility='hidden'" class="w-20 h-20 lg:w-24 lg:h-24 rounded-full border-2 border-mem-gold object-cover mx-auto shadow-[0_0_15px_rgba(212,175,55,0.3)]" /><figcaption class="mt-2 text-sm text-mem-gold font-bold">نيكولا تيسلا</figcaption></figure>
      <figure class="text-center"><img src="/images/einstein.jpg" alt="ينشتاين" onerror="this.style.visibility='hidden'" class="w-20 h-20 lg:w-24 lg:h-24 rounded-full border-2 border-mem-gold object-cover mx-auto shadow-[0_0_15px_rgba(212,175,55,0.3)]" /><figcaption class="mt-2 text-sm text-mem-gold font-bold">لبرت ينشتاين</figcaption></figure>
    </div>
    <div class="max-w-3xl mx-auto rounded-2xl border border-mem-burgundy/60 bg-mem-burgundy/15 p-5 text-center relative z-10">
      <p class="text-sm text-mem-gold mb-2 font-traditional">قال شيخ السلام ابن تيمية - رحمه الله -:</p>
      <blockquote class="text-base lg:text-lg text-mem-ivory font-amiri leading-relaxed">«من كان طالبا للعلم ليحيي به السلام فهو من الصديقين ودرجته بعد درجة النبوة.»</blockquote>
    </div>
  </div>
</section>
<script>
  const c = document.getElementById('particles');
  if (c && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const ctx = c.getContext('2d'); const dpr = Math.min(window.devicePixelRatio || 1, 2);
    let w = 0, h = 0, ps = [], raf = 0, visible = true;
    function resize() { const r = c.getBoundingClientRect(); w = r.width; h = r.height; c.width = w * dpr; c.height = h * dpr; ctx.setTransform(dpr, 0, 0, dpr, 0, 0); const n = w < 640 ? 24 : 55; ps = Array.from({ length: n }, function () { return { x: Math.random() * w, y: Math.random() * h, r: Math.random() * 1.8 + 0.6, vy: -(Math.random() * 0.25 + 0.05), vx: (Math.random() - 0.5) * 0.12, a: Math.random() * Math.PI * 2 }; }); }
    function frame(t) { ctx.clearRect(0, 0, w, h); for (let i = 0; i < ps.length; i++) { const p = ps[i]; p.x += p.vx; p.y += p.vy; if (p.y < -5) { p.y = h + 5; p.x = Math.random() * w; } if (p.x < -5) p.x = w + 5; if (p.x > w + 5) p.x = -5; const alpha = 0.25 + 0.35 * Math.abs(Math.sin(t / 1200 + p.a)); ctx.fillStyle = 'rgba(212,175,55,' + alpha.toFixed(3) + ')'; ctx.beginPath(); ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2); ctx.fill(); for (let j = i + 1; j < ps.length; j++) { const q = ps[j]; const dx = p.x - q.x; const dy = p.y - q.y; const d = Math.sqrt(dx * dx + dy * dy); if (d < 90) { ctx.strokeStyle = 'rgba(212,175,55,' + (0.12 * (1 - d / 90)).toFixed(3) + ')'; ctx.lineWidth = 0.6; ctx.beginPath(); ctx.moveTo(p.x, p.y); ctx.lineTo(q.x, q.y); ctx.stroke(); } } } raf = (visible && !document.hidden) ? requestAnimationFrame(frame) : 0; }
    function start() { if (!raf && visible && !document.hidden) raf = requestAnimationFrame(frame); }
    resize(); window.addEventListener('resize', resize); document.addEventListener('visibilitychange', start);
    if ('IntersectionObserver' in window) { new IntersectionObserver(function (es) { visible = es[0].isIntersecting; start(); }).observe(c); }
    start();
  }
</script>
