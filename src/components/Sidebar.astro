---
// src/components/Sidebar.astro
import { pillarsData } from '../data/academyData';

interface Props {
  activePillarId?: string | number;
}

const { activePillarId } = Astro.props;
---

<aside class="hidden lg:block w-72 shrink-0 h-[calc(100vh-5rem)] sticky top-20 overflow-y-auto custom-scrollbar pr-4 pl-2 py-6 border-l border-[#d4af37]/20">
  
  <div class="mb-6 px-3">
    <h2 class="text-[#d4af37] font-amiri text-lg font-bold flex items-center gap-2">
      <span>🧭</span> خريطة المعارج
    </h2>
    <p class="text-[10px] text-white/40 mt-1">تصفح سريع بين المعامير والمحاور</p>
  </div>

  <div class="space-y-2">
    {pillarsData.map((pillar) => {
      const isActive = activePillarId && String(activePillarId) === String(pillar.id);
      
      return (
        <details class="group" open={isActive}>
          <summary class={`flex items-center justify-between px-3 py-3 rounded-xl cursor-pointer transition-all border ${isActive ? 'bg-[#d4af37]/10 border-[#d4af37]/40' : 'bg-[#12141a] border-white/5 hover:border-[#d4af37]/30 hover:bg-white/[0.02]'}`}>
            <div class="flex items-center gap-2">
              <span class="text-sm">🏛️</span>
              <span class={`text-sm font-bold ${isActive ? 'text-[#d4af37]' : 'text-white/80 group-hover:text-white'}`}>
                {pillar.short}
              </span>
            </div>
            <span class="text-[10px] text-white/30 transition-transform duration-300 group-open:rotate-180">▼</span>
          </summary>
          
          <ul class="mr-4 mt-2 space-y-1 border-r border-[#d4af37]/20 pr-3 py-1">
            {pillar.axes.map((axis, index) => (
              <li>
                <a href={`/pillar/${pillar.id}?axis=${index + 1}`} class="block px-3 py-2 rounded-lg text-xs text-white/60 hover:text-[#d4af37] hover:bg-white/[0.03] transition-colors">
                  {axis}
                </a>
              </li>
            ))}
            
            <li class="pt-2 mt-2 border-t border-white/5">
              <a href={`/pillar/${pillar.id}`} class="flex items-center justify-between px-3 py-2 rounded-lg text-[11px] font-bold text-[#d4af37] bg-[#d4af37]/5 hover:bg-[#d4af37]/15 transition-colors">
                <span>استعراض البوابة كاملة</span>
                <span>➔</span>
              </a>
            </li>
          </ul>
        </details>
      );
    })}
  </div>
</aside>

<style>
  .custom-scrollbar::-webkit-scrollbar { width: 4px; }
  .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
  .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(212, 175, 55, 0.2); border-radius: 4px; }
  .custom-scrollbar:hover::-webkit-scrollbar-thumb { background: rgba(212, 175, 55, 0.5); }
</style>