---
// src/components/ContentCard.astro
export interface Props {
  type: 'article' | 'book' | 'video';
  title: string;
  summary: string;
  url: string;
  meta: string;
}

const { type, title, summary, url, meta } = Astro.props;

const typeConfig = {
  article: {
    label: 'مقال',
    badgeBg: 'bg-emerald-950/60 text-emerald-400 border-emerald-800/40',
    iconColor: 'text-emerald-400',
    hoverBorder: 'hover:border-emerald-500/40',
  },
  book: {
    label: 'كتاب',
    badgeBg: 'bg-amber-950/60 text-amber-400 border-amber-800/40',
    iconColor: 'text-amber-400',
    hoverBorder: 'hover:border-amber-500/40',
  },
  video: {
    label: 'مرئي',
    badgeBg: 'bg-sky-950/60 text-sky-400 border-sky-800/40',
    iconColor: 'text-sky-400',
    hoverBorder: 'hover:border-sky-500/40',
  },
};

const config = typeConfig[type] || typeConfig.article;
---

<a 
  href={url} 
  class={`group relative flex flex-col justify-between rounded-xl border border-slate-800/80 bg-slate-900/90 p-5 shadow-lg transition-all duration-300 hover:-translate-y-1 hover:shadow-2xl ${config.hoverBorder}`}
>
  <div>
    <div class="flex items-center justify-between mb-4">
      <span class={`inline-flex items-center gap-1.5 px-3 py-1 text-xs font-semibold rounded-full border ${config.badgeBg}`}>
        {config.label}
      </span>
      
      <div class={`p-2 rounded-lg bg-slate-800/60 ${config.iconColor}`}>
        {type === 'article' && (
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20H5a2 2 0 01-2-2V6a2 2 0 012-2h10l5 5v11a2 2 0 01-2 2z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 2v4a1 1 0 001 1h4" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 10h10M7 14h8" />
          </svg>
        )}
        {type === 'book' && (
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
        )}
        {type === 'video' && (
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
        )}
      </div>
    </div>

    <h3 class="text-lg font-bold text-slate-100 group-hover:text-amber-400 transition-colors line-clamp-2 leading-snug">
      {title}
    </h3>
    <p class="mt-2 text-sm text-slate-400 line-clamp-3 leading-relaxed">
      {summary}
    </p>
  </div>

  <div class="mt-6 pt-3 border-t border-slate-800/60 flex items-center justify-between text-xs text-slate-400">
    <span class="flex items-center gap-1 font-medium text-slate-400">
      <svg class="w-4 h-4 opacity-70" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
      </svg>
      {meta}
    </span>
    
    <span class="inline-flex items-center font-semibold text-amber-400 group-hover:translate-x-[-4px] transition-transform">
      تصفح المحتوى &larr;
    </span>
  </div>
</a>
