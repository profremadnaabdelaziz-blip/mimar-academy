---
// src/components/MimarRectangularBanner.astro
---
<div class="w-full bg-[#060606] py-4 px-4 md:px-8 select-none" dir="rtl">
  <div class="max-w-[1440px] mx-auto flex flex-col items-center justify-center">
    
    <!-- حاوية البانر (تعرض الصورة الجاهزة) -->
    <div class="w-full max-w-[1240px] overflow-hidden rounded-2xl border border-[#b5945b]/30 bg-black/60 shadow-[0_20px_50px_rgba(0,0,0,0.9)] group">
      <img 
        src="/images/banner-final.webp" 
        alt="أكاديمية معمار - الأستاذ والطالبة" 
        class="w-full h-auto object-cover transition-transform duration-700 group-hover:scale-[1.02]"
      />
    </div>

    <!-- تذييل النطاق الثابت -->
    <div class="mt-2 text-center">
      <p class="text-[#b5945b] font-mono text-[10px] md:text-xs tracking-[0.3em] opacity-80 lowercase">
        platform: academy-mimar
      </p>
    </div>

  </div>
</div>